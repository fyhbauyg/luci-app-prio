#!/bin/sh /etc/rc.common
# luci-app-prio v5 - per-device network priority
# Copyright (C) 2026 congge
#
# Architecture (verified on hardware):
#
#   upload  : LAN client -> router -> eth2 egress       (ETS + fwmark)
#   download: internet -> eth2 -> DNAT -> route -> br-lan egress (tbf -> ETS + fwmark)
#
# Marking (netfilter, before/after NAT):
#   pre  chain (priority mangle - 10): ip saddr @sN -> mark  (upload)
#   post chain (priority dstnat + 10): ip daddr @sN -> mark  (download)
#
# Mark space: bits 16..23 (0x010000 .. 0x800000), private to this package.
#   mwan3 uses 0x100/0x3f00, passwall/openclash use low bits, so nothing collides.
#   Marks are OR-ed in, never written as a whole word, to preserve other modules.
#
# Downlink hierarchy:
#   root tbf (rate = learned WAN rate, creates the backlog)
#     class 10:1
#       ets bands N strict K  (priority; K = strict_bands, 1..N-1)
#         1:1..1:N fq_codel   (per-band fairness)
#
# Why not ifb: the ifb egress qdisc runs before netfilter PREROUTING, so the
# fwmark is not set yet. br-lan egress runs after routing, where it is.
#
# Note: only the first `strict_bands` bands are strict priority, and ETS serves
# them in index order. The remaining bands share bandwidth via DRR with equal
# quanta -- they are NOT ordered relative to each other. With 3 bands, setting
# strict_bands=2 gives three real levels (0 > 1 > 2); the default of 1 gives
# band 0 plus two equal bands.

START=99
STOP=10
# Without this, rc.common rejects `status` and prints its usage text, so every
# caller (LuCI included) sees the service as dead even while it is running.
EXTRA_COMMANDS="status reload apply pickprobe measure"
EXTRA_HELP="	status	Show whether the priority engine is running
	reload	Re-apply the configuration
	apply <0|1>	Re-apply and wait until the committed switch matches <0|1>
	pickprobe	Trace the route and pick the closest answering hop as probe target"

PRIO_STATE=/var/run/luci-app-prio
DETECT_PID="$PRIO_STATE/detect.pid"
HNAT_TOGGLE=/sys/kernel/debug/hnat/hook_toggle
EFFECTIVE_STATE=/var/run/c2000max-hnat-effective
NFT_TABLE="inet luci_prio"
MARK_BASE=0x010000
MARK_MASK=0x00ff0000
TBF_HANDLE=10
UNMARK_MASK=0xff00ffff

state_get() { uci -q get "prio.main.$1"; }
state_set() { uci -q set "prio.main.$1=$2" && uci -q commit prio; }

# A measurement can end without changing anything -- the line was busy, another
# run held the lock, the speedtest client answered nothing. Silently leaving the
# old numbers in place makes the button look dead, so the reason is recorded
# here and the page reports it next to the last measurement.
# ---- persistent diagnostics ------------------------------------------------
# /root, not /var/run: the interesting failures (a band starved for hours, a
# rate pinned at the floor overnight) are only obvious long after the fact,
# and tmpfs is gone by then. Writes happen on events and once every few
# minutes, so the flash cost is negligible; the file is capped and rotated.
PRIO_DIAG=/root/prio-diag.log
PRIO_DIAG_MAX=131072

# Old lines are dropped by timestamp, once a day, so "keep 7 days" means seven
# days of lines and not "the last 128 kB". Runs even when logging is switched
# off: turning the log off must not freeze the old lines on the flash.
diag_prune_file() {
	local f="$1" days="$2" now cut
	[ -s "$f" ] || return 0
	now=$(date +%s)
	cut="$(date -d "@$(( now - days * 86400 ))" +%F 2>/dev/null)"
	[ -n "$cut" ] || return 0
	if awk -v c="$cut" 'length($0) >= 10 && substr($0, 1, 10) >= c { print }' \
		"$f" > "$f.tmp" 2>/dev/null; then
		mv -f "$f.tmp" "$f" 2>/dev/null || { rm -f "$f.tmp"; return 1; }
		return 0
	fi
	rm -f "$f.tmp"
	return 1
}

diag_prune() {
	local days
	days="$(state_get diag_days)"
	case "$days" in ''|*[!0-9]*) days=7 ;; esac
	[ "$days" -ge 1 ] || return 0
	[ "$days" -gt 3650 ] && days=3650
	# The rotated copy as well: otherwise up to 128 kB of arbitrarily old lines
	# survives forever, which is exactly what "keep 7 days" is meant to stop.
	local rc=0
	diag_prune_file "$PRIO_DIAG" "$days" || rc=1
	diag_prune_file "$PRIO_DIAG.1" "$days" || rc=1
	return $rc
}

# Once a day, and callable from anywhere: the log must age out even when the
# engine is stopped or nothing happens for days, so start()/stop() call this
# too instead of relying on diag() being reached by an event.
diag_maybe_prune() {
	local last fail now attempt
	mkdir -p "$PRIO_STATE" 2>/dev/null
	now=$(date +%s)
	last=$(cat "$PRIO_STATE/diag_prune" 2>/dev/null)
	case "$last" in ''|*[!0-9]*) last=0 ;; esac
	fail=$(cat "$PRIO_STATE/diag_prune_fail" 2>/dev/null)
	case "$fail" in ''|*[!0-9]*) fail=0 ;; esac

	# When to try: once a day, or -- after a recorded failure -- every 600 s.
	# The daily branch must be gated on "no failure recorded": a failed prune
	# leaves `last` stale, and without that gate every later call re-enters the
	# daily branch and prunes on each ~20 s window.
	# DIAG_TRY_AT is a shell variable, so it also bounds the case where even the
	# stamps cannot be written (read-only overlay, full flash): it only resets
	# when the process restarts.
	attempt=0
	if [ "$fail" -eq 0 ] && [ $(( now - last )) -ge 86400 ]; then
		attempt=1
	elif [ "$fail" -gt 0 ] && [ $(( now - fail )) -ge 600 ]; then
		attempt=1
	fi
	[ "$attempt" = 1 ] || return 0
	[ $(( now - ${DIAG_TRY_AT:-0} )) -ge 600 ] || return 0
	DIAG_TRY_AT=$now

	if diag_prune; then
		printf '%s\n' "$now" > "$PRIO_STATE/diag_prune" 2>/dev/null
		: > "$PRIO_STATE/diag_prune_fail" 2>/dev/null
	else
		printf '%s\n' "$now" > "$PRIO_STATE/diag_prune_fail" 2>/dev/null
	fi
}

diag() {
	# Prune before the on/off check: switching the log off must not freeze the
	# lines that are already there.
	diag_maybe_prune
	[ "$(state_get diag)" = "0" ] && return 0
	printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$PRIO_DIAG" 2>/dev/null || return 0
	local sz
	sz=$(wc -c < "$PRIO_DIAG" 2>/dev/null)
	case "$sz" in ''|*[!0-9]*) return 0 ;; esac
	if [ "$sz" -gt "$PRIO_DIAG_MAX" ]; then
		# If the rename fails the file would grow without bound, so fall back
		# to truncating it: losing history beats filling the overlay.
		mv -f "$PRIO_DIAG" "$PRIO_DIAG.1" 2>/dev/null || : > "$PRIO_DIAG"
	fi
}

# One line per band: bytes and drops, so a starving band can be told apart
# from a starving line. Uses tc's own counters -- no extra traffic.
diag_bands() {
	local dev="${1:-br-lan}" b out
	out=""
	for b in 2:1 2:2 2:3; do
		# "Sent <bytes> bytes <pkts> pkt (dropped <n>, overlimits <n> ...":
		# field 2 is the byte count, field 7 the drop count.
		out="$out $(tc -s class show dev "$dev" 2>/dev/null |
			awk -v c="class ets $b" -v lab="$b" '$0 ~ c {f=1; next} f && /Sent/ {
				printf "%s=%dMB/%dd", lab, int($2/1048576), $7; exit }' 2>/dev/null)"
	done
	echo "$out"
}

mea_fail() {
	mkdir -p "$PRIO_STATE" 2>/dev/null
	# Optional extra fields: line-busy carries "observed threshold" in kbit so
	# the page can say how much traffic blocked the run instead of only that
	# something did.
	local extra
	extra=""
	[ -n "$2" ] && extra=" $2"
	[ -n "$3" ] && extra="$extra $3"
	printf '%s %s%s\n' "${MEASURE_NOW:-$(date +%s)}" "$1" "$extra" > "$PRIO_STATE/measure_err" 2>/dev/null
}
mea_ok() {
	mkdir -p "$PRIO_STATE" 2>/dev/null
	: > "$PRIO_STATE/measure_err" 2>/dev/null
}

# Serialises start/stop so overlapping reloads (double-click on save, two
# browser tabs, a save racing a disable) cannot interleave nft/tc changes and
# leave a half-configured engine. Re-entrant so reload() can call start().
PRIO_LOCK="$PRIO_STATE/lock"
LOCK_HELD=0

acquire_lock() {
	[ "$LOCK_HELD" = 1 ] && return 0
	mkdir -p "$PRIO_STATE" 2>/dev/null
	local i=0 owner
	while ! mkdir "$PRIO_LOCK" 2>/dev/null; do
		# Reclaim a lock whose owner died (Ctrl-C, SIGTERM, watchdog). Without
		# this a single interrupted start would block every later reload until
		# the router reboots.
		owner="$(cat "$PRIO_LOCK/pid" 2>/dev/null)"
		if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
			rm -rf "$PRIO_LOCK" 2>/dev/null
			continue
		fi
		i=$((i + 1))
		if [ "$i" -ge 30 ]; then
			echo "lock:timeout" >> "$PRIO_STATE/err"
			logger -t luci-app-prio "could not acquire lock, giving up"
			return 1
		fi
		sleep 1
	done
	printf '%s\n' "$$" > "$PRIO_LOCK/pid" 2>/dev/null
	trap 'release_lock' EXIT INT TERM HUP
	LOCK_HELD=1
	return 0
}

release_lock() {
	[ "$LOCK_HELD" = 1 ] || return 0
	rm -f "$PRIO_LOCK/pid" 2>/dev/null
	rmdir "$PRIO_LOCK" 2>/dev/null
	LOCK_HELD=0
}

# How many leading bands are strict priority. sch_ets serves the strict bands
# in index order and only then falls through to DRR for the rest, so
# strict=2 with 3 bands really is three levels: 0 > 1 > 2.
# A value of N (all bands strict) leaves no DRR band and is rejected here.
strict_count() {
	local bands="$1" v max
	v="$(state_get strict_bands)"
	case "$v" in ''|*[!0-9]*) v=1 ;; esac
	max=$((bands - 1))
	[ "$max" -lt 1 ] && max=1
	[ "$v" -gt "$max" ] && v="$max"
	[ "$v" -lt 1 ] && v=1
	echo "$v"
}

band_mark() {
	local b="$1"
	case "$b" in 0|1|2|3|4|5|6|7) ;; *) b=0 ;; esac
	echo $((MARK_BASE << b))
}

qdisc_is_ours() {
	tc qdisc show dev "$1" 2>/dev/null | grep -qE 'qdisc htb 1: root|qdisc ets 2: root|qdisc tbf 10: root|qdisc ets 1: root'
}

wait_hnat_down() {
	local i=0
	while [ "$i" -lt 25 ]; do
		[ "$(cat "$HNAT_TOGGLE" 2>/dev/null)" = "disabled" ] && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

shaper_kbit() {
	local r
	r="$(cat "$PRIO_STATE/shaper" 2>/dev/null)"
	case "$r" in ''|*[!0-9]*) r='' ;; esac
	# /var/run is a tmpfs, so the learned rate disappears on reboot. Keep a
	# committed copy too, otherwise every boot restarts from zero and the
	# value depends on whatever the first burst after boot happens to be.
	if [ -z "$r" ] && [ "$(state_get auto_bandwidth)" = "1" ]; then
		r="$(state_get shaper_learned)"
		case "$r" in ''|*[!0-9]*) r='' ;; esac
	fi
	# The manual value is ONLY authoritative when auto-detection is off. Using
	# it as a seed while auto is on would silently start the learner from a
	# number the user was told would be ignored.
	if [ -z "$r" ] && [ "$(state_get auto_bandwidth)" != "1" ]; then
		r="$(state_get shaper_kbit)"
	fi
	case "$r" in ''|*[!0-9]*) r=0 ;; esac
	[ "$r" -ge 1000 ] 2>/dev/null || r=0
	echo "$r"
}

# Safety margin. The learned value is the line's estimated capacity; the rate
# actually handed to tc is that estimate reduced by this percentage. Shaping
# *below* the real capacity is what keeps the backlog in our qdisc instead of
# the ISP's buffer -- with no local queue there is nothing for the priority
# scheduler to reorder, which is why priority used to "wake up late".
margin_pct() {
	local m
	m="$(state_get shaper_margin)"
	case "$m" in ''|*[!0-9]*) m=10 ;; esac
	[ "$m" -gt 50 ] && m=50
	echo "$m"
}

applied_kbit() {
	local est="$1" m
	case "$est" in ''|*[!0-9]*) est=0 ;; esac
	# A manually entered rate is a number the user asked for and must be used
	# verbatim. Only the learned estimate is hedged with a safety margin,
	# because only that one is a guess.
	if [ "$(state_get auto_bandwidth)" != "1" ]; then
		echo "$est"
		return 0
	fi
	m="$(margin_pct)"
	echo $(( est * (100 - m) / 100 ))
}

# Valve for every band except the top one: the same number the old code handed
# to tc as the global shaped rate (estimate minus the safety margin). The margin
# no longer comes off the total, so the top band may use the whole measured
# capacity while every lower band is held below the knee.
valve_of() {
	local r="$1" m v
	case "$r" in ''|*[!0-9]*) r=0 ;; esac
	[ "$r" -ge 1000 ] 2>/dev/null || { echo 0; return 0; }
	m="$(margin_pct)"
	v=$(( r * (100 - m) / 100 ))
	[ "$v" -lt 2000 ] && v=2000
	[ "$v" -gt "$r" ] && v="$r"
	echo "$v"
}

# Total gate handed to tc verbatim.
total_kbit() {
	shaper_kbit
}

valve_kbit() {
	valve_of "$(total_kbit)"
}

# Per-band valve: every band except the top one gets its own HTB class capped at
# $valve, so a lower band can never take the whole line. The top band stays
# unshaped inside the ETS scheduler and may reach the total gate.
add_band_valves() {
	local dev="$1" bands="$2" valve="$3"
	local b vh vb
	[ "$valve" -ge 1000 ] 2>/dev/null || return 0
	[ "$bands" -gt 1 ] 2>/dev/null || return 0
	b=1
	while [ "$b" -lt "$bands" ]; do
		vh=$((20 + b))
		vb=$(( valve / 8 * 20 ))
		[ "$vb" -lt 8192 ] && vb=8192
		[ "$vb" -gt 128000 ] && vb=128000
		tc qdisc add dev "$dev" parent "2:$((b + 1))" handle "${vh}:" htb default 1 2>>"$PRIO_STATE/err"
		tc class add dev "$dev" parent "${vh}:" classid "${vh}:1" htb \
			rate "${valve}kbit" ceil "${valve}kbit" burst "${vb}b" cburst "${vb}b" 2>>"$PRIO_STATE/err"
		b=$((b + 1))
	done
	return 0
}

# Rate changes must not rebuild the tree, so the valves are changed in place.
set_band_valves() {
	local dev="$1" bands="$2" valve="$3"
	local b vh vb
	[ "$valve" -ge 1000 ] 2>/dev/null || return 0
	b=1
	while [ "$b" -lt "$bands" ]; do
		vh=$((20 + b))
		vb=$(( valve / 8 * 20 ))
		[ "$vb" -lt 8192 ] && vb=8192
		[ "$vb" -gt 128000 ] && vb=128000
		tc class change dev "$dev" parent "${vh}:" classid "${vh}:1" htb \
			rate "${valve}kbit" ceil "${valve}kbit" burst "${vb}b" cburst "${vb}b" 2>>"$PRIO_STATE/err"
		b=$((b + 1))
	done
	return 0
}

# Rate for the LAN class. 0 in the config means "detect": the highest link
# speed reported by the bridge members, falling back to 1 Gbit/s (the usual
# wired port on this box). Shaping the LAN at its real link speed builds a
# queue without capping throughput below what the wire can do.
lan_rate_kbit() {
	local lan="$1" r
	r="$(state_get lan_rate_kbit)"
	case "$r" in ''|*[!0-9]*) r=0 ;; esac
	if [ "$r" -ge 1000 ]; then
		echo "$r"
		return
	fi

	local best=0 s m
	for m in /sys/class/net/"$lan"/brif/*; do
		[ -e "$m" ] || continue
		# WiFi members either have no speed file or report a signalling rate
		# far above the wired line rate; using it would make the class too fast
		# to ever form a queue.
		[ -e "$m/wireless" ] && continue
		[ "$(cat "$m/operstate" 2>/dev/null)" = "up" ] || continue
		s=$(cat "$m/speed" 2>/dev/null)
		case "$s" in ''|*[!0-9]*) continue ;; esac
		[ "$s" -gt "$best" ] && best=$s
	done
	if [ "$best" -eq 0 ]; then
		s=$(cat "/sys/class/net/$lan/speed" 2>/dev/null)
		case "$s" in ''|*[!0-9]*) s=0 ;; esac
		best=$s
	fi
	# Unknown link speed must NOT become a guess that could throttle a faster
	# port: use a value above any realistic LAN so the class never limits.
	[ "$best" -gt 0 ] || best=10000
	echo $((best * 1000))
}

# ---------------- nft marking ----------------
# Resolve one configured IPv4 address to the client's MAC. Everything IPv6
# hangs off this: a Windows/Android client rotates its privacy address every
# few hours, so the address in UCI is only a stable handle on the *device*.
# The MAC is what actually identifies it, and it is what the neighbour table
# lets us map back to whatever address the client is using right now.
mac_for_ip() {
	local ip="$1" mac
	mac="$(ip neigh show "$ip" 2>/dev/null | grep -o 'lladdr [0-9a-f:]*' | head -n1 | cut -d' ' -f2)"
	[ -n "$mac" ] || mac="$(ip -6 neigh show to "$ip" 2>/dev/null | grep -o 'lladdr [0-9a-f:]*' | head -n1 | cut -d' ' -f2)"
	[ -n "$mac" ] || mac="$(awk -v ip="$ip" '$3==ip && NF>=3 {print $2}' /tmp/dhcp.leases 2>/dev/null | head -n1)"
	case "$mac" in
		*:*) echo "$mac" ;;
		*) : ;;
	esac
}

# Looks up the band a MAC was registered with. Empty when unknown.
band_for_mac() {
	# "downband upband"; older maps only carry the first one
	awk -v mac="$1" '$1==mac {print $2, ($3 == "" ? $2 : $3); exit}' "$PRIO_STATE/macmap" 2>/dev/null
}

# True when the address is already in the set for that band, so the periodic
# refresh does not re-add (and re-log) the same elements every tick.
addr_known() {
	grep -qxF "$1 $2" "$PRIO_STATE/addrseen" 2>/dev/null
}

addr_remember() {
	printf '%s %s\n' "$1" "$2" >> "$PRIO_STATE/addrseen"
}

prio_nft_device() {
	local section="$1"
	local enabled ip band
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get ip "$section" ip
	config_get band "$section" band 0
	config_get band_up "$section" band_up
	# One priority for both directions unless the user explicitly turned on the
	# split. Leaving a stale band_up behind must not silently divide them.
	local split
	config_get_bool split main split_bands 0
	if [ "$split" != 1 ]; then
		band_up="$band"
	else
		# No separate upload band means "same as download".
		[ -n "$band_up" ] || band_up="$band"
	fi
	[ -n "$ip" ] || return 0
	# A stale or mistyped band must never grant top priority. Non-numeric and
	# out-of-range values both clamp DOWN to the lowest band.
	case "$band" in
		''|*[!0-9]*)
			echo "band:invalid:${ip}:'${band}'" >> "$PRIO_STATE/err"
			band="$PRIO_BANDS_MAX"
			;;
	esac
	if [ "$band" -gt "$PRIO_BANDS_MAX" ] 2>/dev/null; then
		echo "band:clamped:${ip}:${band}" >> "$PRIO_STATE/err"
		band="$PRIO_BANDS_MAX"
	fi
	case "$band_up" in
		''|*[!0-9]*) band_up="$band" ;;
	esac
	if [ "$band_up" -gt "$PRIO_BANDS_MAX" ] 2>/dev/null; then
		band_up="$PRIO_BANDS_MAX"
	fi

	# dedupe: one IP must only live in one band
	if grep -q "^${ip} " "$PRIO_STATE/ipmap" 2>/dev/null; then
		echo "dup:${ip}" >> "$PRIO_STATE/err"
		return 0
	fi

	if nft add element "$NFT_TABLE" "s${band}" "{ $ip }" 2>>"$PRIO_STATE/err"; then
		nft add element "$NFT_TABLE" "su${band_up}" "{ $ip }" 2>>"$PRIO_STATE/err"
		printf '%s %s %s\n' "$ip" "$band" "$band_up" >> "$PRIO_STATE/ipmap"
		# Remember the device identity for the IPv6 side. A failed lookup is
		# not fatal: IPv4 keeps working and the refresh loop retries later.
		local mac
		mac="$(mac_for_ip "$ip")"
		if [ -n "$mac" ]; then
			if ! grep -q "^${mac} " "$PRIO_STATE/macmap" 2>/dev/null; then
				printf '%s %s %s\n' "$mac" "$band" "$band_up" >> "$PRIO_STATE/macmap"
			fi
		else
			echo "mac:unknown:${ip}" >> "$PRIO_STATE/err"
		fi
	else
		echo "elem-fail:${ip}" >> "$PRIO_STATE/err"
	fi
}

# Fill the per-band address sets from the kernel neighbour tables.
#
# This is the whole IPv6 story: the router cannot predict which temporary
# address a client will use, but while that client is downloading, its address
# *is* in the neighbour table together with its MAC. Matching on the MAC gives
# IPv4 and IPv6 -- including privacy addresses -- with one mechanism, and the
# periodic re-run picks up a rotated address within a few seconds.
refresh_addrs() {
	local lan="$1"
	refresh_family "$lan" 4
	refresh_family "$lan" 6
}

refresh_family() {
	local lan="$1" fam="$2" addr rest mac band bup set
	local list="$PRIO_STATE/.neigh.$$"
	if [ "$fam" = 6 ]; then
		ip -6 neigh show dev "$lan" 2>/dev/null > "$list"
	else
		ip neigh show dev "$lan" 2>/dev/null > "$list"
	fi
	[ -s "$list" ] || { : > "$list"; return 0; }
	while read -r addr rest; do
		case "$addr" in
			''|*[!0-9a-fA-F:.]*) continue ;;
		esac
		mac="$(printf '%s\n' "$rest" | grep -o 'lladdr [0-9a-f:]*' | cut -d' ' -f2)"
		[ -n "$mac" ] || continue
		band="$(band_for_mac "$mac" | cut -d' ' -f1)"
		bup="$(band_for_mac "$mac" | cut -d' ' -f2)"
		[ -n "$band" ] || continue
		[ -n "$bup" ] || bup="$band"
		for set in \
			"$([ "$fam" = 6 ] && echo "s6_${band}" || echo "s${band}")" \
			"$([ "$fam" = 6 ] && echo "s6u_${bup}" || echo "su${bup}")"; do
			[ -n "$set" ] || continue
			addr_known "$set" "$addr" && continue
			if nft add element "$NFT_TABLE" "$set" "{ $addr }" 2>/dev/null; then
				addr_remember "$set" "$addr"
			fi
		done
	done < "$list"
	: > "$list"
}

setup_nft() {
	local bands="$1"
	local wan="$2"
	local lan="$3"
	PRIO_BANDS_MAX=$((bands - 1))
	# Devices that are not in the list still have to be managed: they get this
	# band, which defaults to the lowest (worst) priority. Without a default the
	# unlisted traffic simply skipped the shaper -- an unmanaged phone uploaded
	# at 80 Mbit while every managed device sat under the cap.
	local dband
	dband="$(state_get default_band)"
	case "$dband" in ''|*[!0-9]*) dband="$PRIO_BANDS_MAX" ;; esac
	[ "$dband" -gt "$PRIO_BANDS_MAX" ] && dband="$PRIO_BANDS_MAX"

	nft delete table $NFT_TABLE 2>/dev/null
	# One-time migration: v5 and earlier used a table literally named "prio".
	# Leaving it behind would double-mark packets from stale sets.
	nft delete table inet prio 2>/dev/null
	nft add table $NFT_TABLE 2>>"$PRIO_STATE/err" || { echo "nft:fail" >> "$PRIO_STATE/status"; return 1; }

	local b
	for b in 0 1 2 3 4 5 6 7; do
		nft add set $NFT_TABLE "s${b}" '{ type ipv4_addr; flags interval; }' 2>>"$PRIO_STATE/err"
		# IPv6 mirrors of the same bands. Kept separate because a set has one
		# address family; the band number and mark are shared.
		nft add set $NFT_TABLE "s6_${b}" '{ type ipv6_addr; flags interval; }' 2>>"$PRIO_STATE/err"
		# Upload can be graded differently from download, so it needs its own
		# sets: same device, possibly a different band.
		nft add set $NFT_TABLE "su${b}" '{ type ipv4_addr; flags interval; }' 2>>"$PRIO_STATE/err"
		nft add set $NFT_TABLE "s6u_${b}" '{ type ipv6_addr; flags interval; }' 2>>"$PRIO_STATE/err"
	done

	config_foreach prio_nft_device device

	# Upload: mark in the FORWARD hook with oifname = WAN. Forward runs after
	# routing but before SNAT, so saddr is still the client's address, while
	# oifname keeps LAN-to-LAN frames (which never leave via the WAN) unmarked.
	# NOTE: the chain cannot be called "fwd" -- that is an nftables keyword.
	nft add chain $NFT_TABLE upmark \
		'{ type filter hook forward priority mangle; policy accept; }' 2>>"$PRIO_STATE/err"

	# Download: ONE chain holds both the default band and the per-device
	# overrides. Two chains at different priorities looked correct on paper
	# (dstnat before dstnat+10) but in practice the default rule overwrote the
	# per-device mark, so everything landed in the lowest band. Inside a single
	# chain the evaluation order is guaranteed: rule 1 stamps the default band,
	# the rules after it overwrite it for registered devices.
	nft add chain $NFT_TABLE post \
		'{ type filter hook prerouting priority dstnat + 10; policy accept; }' 2>>"$PRIO_STATE/err"

	local rules=0
	if nft add rule $NFT_TABLE post iifname "$wan" \
		meta mark set meta mark and "$UNMARK_MASK" or "$(band_mark "$dband")" \
		2>>"$PRIO_STATE/err"; then
		rules=$((rules + 1))
	fi
	# Same default for the upload direction. This rule must come before the
	# per-device ones: later rules overwrite the mark for the devices that are
	# listed, and everything else keeps the default band.
	if nft add rule $NFT_TABLE upmark oifname "$wan" \
		meta mark set meta mark and "$UNMARK_MASK" or "$(band_mark "$dband")" \
		2>>"$PRIO_STATE/err"; then
		rules=$((rules + 1))
	fi

	for b in 0 1 2 3 4 5 6 7; do
		local mark
		mark="$(band_mark "$b")"
		if nft add rule $NFT_TABLE upmark oifname "$wan" ip saddr "@su${b}" \
			meta mark set meta mark and "$UNMARK_MASK" or "$mark" 2>>"$PRIO_STATE/err"; then
			rules=$((rules + 1))
		fi
		if nft add rule $NFT_TABLE upmark oifname "$wan" ip6 saddr "@s6u_${b}" \
			meta mark set meta mark and "$UNMARK_MASK" or "$mark" 2>>"$PRIO_STATE/err"; then
			rules=$((rules + 1))
		fi
		if nft add rule $NFT_TABLE post iifname "$wan" ip daddr "@s${b}" \
			meta mark set meta mark and "$UNMARK_MASK" or "$mark" 2>>"$PRIO_STATE/err"; then
			rules=$((rules + 1))
		fi
		if nft add rule $NFT_TABLE post iifname "$wan" ip6 daddr "@s6_${b}" \
			meta mark set meta mark and "$UNMARK_MASK" or "$mark" 2>>"$PRIO_STATE/err"; then
			rules=$((rules + 1))
		fi
	done

	# Resolve every registered device's current addresses now, then keep them
	# fresh (see start_refresh) so a rotated IPv6 address is picked up too.
	[ -n "$lan" ] && refresh_addrs "$lan"

	if [ "$rules" -gt 0 ]; then
		echo "nft:ok($rules)" >> "$PRIO_STATE/status"
	else
		echo "nft:fail" >> "$PRIO_STATE/status"
		return 1
	fi
	return 0
}

# ---------------- helpers ----------------
band_leaves() {
	local dev="$1" bands="$2" handle="${3:-1}" valve="${4:-0}"
	local fq p
	fq="$(state_get fq_codel)"
	[ -n "$fq" ] || fq=1
	[ "$fq" = "1" ] || return 0
	# target 3ms, not the 5ms default: with the shaper deliberately running
	# below the line rate, this queue is the one the gamer actually sits in, so
	# its standing delay is worth two milliseconds of throughput. interval stays
	# at the default 100ms -- 3ms is well below half of it, which is the only
	# constraint fq_codel puts on the pair.
	local i=1
	while [ "$i" -le "$bands" ]; do
		# Band 1 (index 0) is never valved, so its leaf hangs directly off the
		# ETS band; the others hang off the HTB class that enforces the valve.
		if [ "$i" -gt 1 ] && [ "$valve" -ge 1000 ] 2>/dev/null; then
			p="$((19 + i)):1"
		else
			p="${handle}:$i"
		fi
		tc qdisc add dev "$dev" parent "$p" fq_codel target 3ms 2>>"$PRIO_STATE/err"
		i=$((i + 1))
	done
}

setup_filters() {
	local dev="$1" bands="$2" handle="${3:-1}"
	local b
	for b in 0 1 2 3 4 5 6 7; do
		[ "$b" -lt "$bands" ] || break
		tc filter add dev "$dev" parent "${handle}:" protocol all prio 1 \
			handle "$(band_mark "$b")/$MARK_MASK" fw flowid "${handle}:$((b + 1))" 2>>"$PRIO_STATE/err"
	done
}

# ---------------- uplink: ETS at eth2 root ----------------
# Rate for the shaped uplink class.
#   uplink_kbit >= 1000  the number the user typed. It is the seed the
#                        controller works from, and a learned value that
#                        outranks a deliberate low setting is exactly the
#                        failure this feature exists to prevent -- so the live
#                        value only counts while it was learned under the same
#                        config value (up_cfg).
#   uplink_kbit == 0     automatic: the live value in tmpfs, else the copy
#                        committed by the last start() (uplink_learned)
#   nothing              unshaped (setup_uplink builds the tree open at 1 Gbit)
up_rate_kbit() {
	local r m c
	m="$(state_get uplink_kbit)"
	case "$m" in ''|*[!0-9]*) m=0 ;; esac
	r="$(cat "$PRIO_STATE/up_rate" 2>/dev/null)"
	case "$r" in ''|*[!0-9]*) r="" ;; esac
	if [ -n "$r" ]; then
		c="$(cat "$PRIO_STATE/up_cfg" 2>/dev/null)"
		case "$c" in ''|*[!0-9]*) c=0 ;; esac
		if [ "$m" -lt 1000 ] || [ "$c" = "$m" ]; then
			echo "$r"
			return
		fi
	fi
	if [ "$m" -ge 1000 ]; then
		echo "$m"
		return
	fi
	# /var/run is a tmpfs: after a reboot, or a save that did not carry the
	# live value, fall back to the committed copy instead of restarting at
	# "open" and re-learning from scratch.
	r="$(state_get uplink_learned)"
	case "$r" in ''|*[!0-9]*) r=0 ;; esac
	[ "$r" -lt 1000 ] 2>/dev/null && r=0
	echo "$r"
}

# Write the live uplink rate, remembering which uplink_kbit it was learned
# under so a later manual change cannot be shadowed by it.
set_up_rate() {
	local c
	printf '%s\n' "$1" > "$PRIO_STATE/up_rate" 2>/dev/null
	c="$(state_get uplink_kbit)"
	case "$c" in ''|*[!0-9]*) c=0 ;; esac
	printf '%s\n' "$c" > "$PRIO_STATE/up_cfg" 2>/dev/null
}

apply_uplink_rate() {
	local dev="$1" rate="$2"
	local burst valve bands
	case "$rate" in ''|*[!0-9]*) rate=0 ;; esac
	bands="$(state_get bands)"
	case "$bands" in 3|4|8) ;; *) bands=3 ;; esac
	burst=$((rate / 8 * 20))
	[ "$burst" -lt 8192 ] && burst=8192
	[ "$burst" -gt 128000 ] && burst=128000
	tc class change dev "$dev" parent 1: classid 1:100 \
		htb rate "${rate}kbit" ceil "${rate}kbit" \
		burst "${burst}b" cburst "${burst}b" 2>>"$PRIO_STATE/err" || return 1
	valve="$(valve_of "$rate")"
	set_band_valves "$dev" "$bands" "$valve"
	refresh_status_rate upvalve "$rate" "$valve"
	# The page reads this; setup_uplink only writes it once at start(), so the
	# controller has to keep it current. It lives in its own file: the old
	# version rewrote the shared status file (grep into a temp file, then mv),
	# which races with start()'s truncation and with the other writers and can
	# silently drop lines written in between.
	printf '%s\n' "${rate}kbit" > "$PRIO_STATE/upshaper" 2>/dev/null
	return 0
}

# ---------------- uplink: optional HTB + ETS at eth2 root ----------------
# Without a rate the uplink is only a scheduler, which is useless the moment
# someone uploads: the modem buffers a couple of seconds of packets and the
# router never sees them. With a rate the queue is ours and the bands matter.
setup_uplink() {
	local dev="$1" bands="$2"
	local rate applied valve

	rate="$(up_rate_kbit)"
	applied=$rate

	qdisc_is_ours "$dev" && tc qdisc del dev "$dev" root 2>/dev/null

	# No rate known yet (uplink_kbit=0 and nothing learned): build the tree
	# anyway at a rate the link can never reach, so the controller can start
	# shaping later without rebuilding -- and measure the upload first.
	local upauto=0
	valve=0
	if [ "$applied" -lt 1000 ]; then
		applied=1000000
		upauto=1
	else
		valve="$(valve_of "$applied")"
	fi

	local burst=$((applied / 8 * 20))
	[ "$burst" -lt 8192 ] && burst=8192
	[ "$burst" -gt 128000 ] && burst=128000

	if ! tc qdisc add dev "$dev" root handle 1: htb default 1 2>>"$PRIO_STATE/err"; then
		echo "uplink:fail" >> "$PRIO_STATE/status"
		return 1
	fi
	# 1:1 is everything that carries no band mark; 1:100 is internet traffic.
	tc class add dev "$dev" parent 1: classid 1:1 htb rate 10Gbit ceil 10Gbit 2>>"$PRIO_STATE/err"
	if ! tc class add dev "$dev" parent 1: classid 1:100 htb rate "${applied}kbit" ceil "${applied}kbit" burst "${burst}b" cburst "${burst}b" 2>>"$PRIO_STATE/err"; then
		tc qdisc del dev "$dev" root 2>/dev/null
		echo "uplink:fail" >> "$PRIO_STATE/status"
		return 1
	fi
	local b
	for b in 0 1 2 3 4 5 6 7; do
		[ "$b" -lt "$bands" ] || break
		tc filter add dev "$dev" parent 1: protocol all prio 1 \
			handle "$(band_mark "$b")/$MARK_MASK" fw flowid 1:100 2>>"$PRIO_STATE/err"
	done
	if ! tc qdisc add dev "$dev" parent 1:100 handle 2: ets bands "$bands" strict "$(strict_count "$bands")" 2>>"$PRIO_STATE/err"; then
		tc qdisc del dev "$dev" root 2>/dev/null
		echo "uplink:fail" >> "$PRIO_STATE/status"
		return 1
	fi
	add_band_valves "$dev" "$bands" "$valve"
	band_leaves "$dev" "$bands" 2 "$valve"
	setup_filters "$dev" "$bands" 2
	echo "upvalve:${valve}kbit" >> "$PRIO_STATE/status"
	echo "uplink:ok" >> "$PRIO_STATE/status"
	if [ "$upauto" = 1 ]; then
		# "auto" means the detector is going to measure the upload. When the
		# learner is off (auto_bandwidth=0 or downlink disabled) nothing will
		# ever do that, so say so instead of claiming it is measuring.
		if [ "$(state_get auto_bandwidth)" = "1" ] && [ "$(state_get downlink)" = "1" ]; then
			printf '%s\n' "auto" > "$PRIO_STATE/upshaper" 2>/dev/null
		else
			printf '%s\n' "pending" > "$PRIO_STATE/upshaper" 2>/dev/null
		fi
	else
		printf '%s\n' "${applied}kbit" > "$PRIO_STATE/upshaper" 2>/dev/null
	fi
	return 0
}

# ---------------- downlink: htb, only the internet class is shaped ----------------
# LAN-to-LAN traffic carries no band mark (the nft post chain only tags packets
# arriving on the WAN), so it lands in the default class 1:1 which is set to a
# rate far above the LAN link -- effectively unlimited. Only marked traffic
# (i.e. internet downloads) enters 1:100, which is shaped to the learned WAN
# rate so the ETS inside it has a real queue to reorder.
setup_downlink() {
	local dev="$1" bands="$2"
	local rate applied valve
	rate="$(shaper_kbit)"
	applied="$(total_kbit)"
	valve="$(valve_of "$applied")"

	# Strip our own lines before re-emitting them; the detector calls this
	# repeatedly and must not accumulate duplicate status rows.
	if [ -f "$PRIO_STATE/status" ]; then
		grep -vE '^(shaper|downlink|lanq):' "$PRIO_STATE/status" > "$PRIO_STATE/status.$$" 2>/dev/null
		mv "$PRIO_STATE/status.$$" "$PRIO_STATE/status" 2>/dev/null
	fi

	qdisc_is_ours "$dev" && tc qdisc del dev "$dev" root 2>/dev/null

	if [ "$rate" -ge 1000 ]; then
		# burst ~20ms of traffic, clamped to a sane window
		local burst=$((applied / 8 * 20))
		[ "$burst" -lt 8192 ] && burst=8192
		[ "$burst" -gt 256000 ] && burst=256000
		# Default: the LAN class is effectively unlimited (10 Gbit). With LAN
		# queueing enabled it is shaped at the real link speed instead, which
		# builds a queue without capping below what the wire can actually do.
		local lanrate
		if [ "$(state_get lan_shaping)" = "1" ]; then
			lanrate="$(lan_rate_kbit "$dev")"
			echo "lanq:${lanrate}kbit" >> "$PRIO_STATE/status"
		else
			lanrate=10000000
			echo "lanq:off" >> "$PRIO_STATE/status"
		fi

		if ! tc qdisc add dev "$dev" root handle 1: htb default 1 2>>"$PRIO_STATE/err"; then
			echo "downlink:fail" >> "$PRIO_STATE/status"
			return 1
		fi
		tc class add dev "$dev" parent 1: classid 1:1 htb rate "${lanrate}kbit" ceil "${lanrate}kbit" 2>>"$PRIO_STATE/err"
		# HTB leaves default to a plain pfifo; give the LAN class the same
		# per-flow fairness the band classes get, otherwise a single local flow
		# can starve the rest of the bridge.
		tc qdisc add dev "$dev" parent 1:1 fq_codel target 3ms 2>>"$PRIO_STATE/err"
		# cburst must be set explicitly: tc defaults it to 1600 bytes, which
		# starves the burst at exactly the moment a download ramps up.
		if ! tc class add dev "$dev" parent 1: classid 1:100 htb rate "${applied}kbit" ceil "${applied}kbit" \
			burst "${burst}b" cburst "${burst}b" 2>>"$PRIO_STATE/err"; then
			tc qdisc del dev "$dev" root 2>/dev/null
			echo "downlink:fail" >> "$PRIO_STATE/status"
			return 1
		fi

		# Outer classifier: any packet carrying one of our band marks is internet
		# traffic and must go through the shaped class.
		local b
		for b in 0 1 2 3 4 5 6 7; do
			tc filter add dev "$dev" parent 1: protocol all prio 1 \
				handle "$(band_mark "$b")/$MARK_MASK" fw flowid 1:100 2>>"$PRIO_STATE/err"
		done

		if ! tc qdisc add dev "$dev" parent 1:100 handle 2: ets bands "$bands" strict "$(strict_count "$bands")" 2>>"$PRIO_STATE/err"; then
			tc qdisc del dev "$dev" root 2>/dev/null
			echo "downlink:fail" >> "$PRIO_STATE/status"
			return 1
		fi
		add_band_valves "$dev" "$bands" "$valve"
		echo "shaper:${applied}kbit" >> "$PRIO_STATE/status"
		echo "valve:${valve}kbit" >> "$PRIO_STATE/status"
	else
		# No rate learned yet: classification only, no queue (priority is inert
		# until the detector has seen enough traffic).
		if ! tc qdisc add dev "$dev" root handle 2: ets bands "$bands" strict "$(strict_count "$bands")" 2>>"$PRIO_STATE/err"; then
			echo "downlink:fail" >> "$PRIO_STATE/status"
			return 1
		fi
		echo "shaper:pending" >> "$PRIO_STATE/status"
	fi

	band_leaves "$dev" "$bands" 2 "$valve"
	setup_filters "$dev" "$bands" 2
	# "ok" used to be written even on the classification-only path, so the page
	# claimed "downlink OK" while no queue existed and priority was inert.
	if [ "$rate" -ge 1000 ]; then
		echo "downlink:ok" >> "$PRIO_STATE/status"
	else
		echo "downlink:inert" >> "$PRIO_STATE/status"
	fi
	return 0
}

# ---------------- IPv6 address refresh ----------------
# A client that starts a new connection picks a new RFC 4941 temporary address.
# The nft sets therefore cannot be filled once at start; they are topped up from
# the neighbour table a few times a minute. Nothing is ever removed: a stale
# entry costs one set slot, while dropping a live one would silently return that
# device to the default band mid-download.
stop_refresh() {
	local pid
	pid="$(cat "$PRIO_STATE/refresh.pid" 2>/dev/null)"
	if [ -n "$pid" ]; then
		kill "$pid" 2>/dev/null
	fi
	printf 'stopped.%s\n' "$$" > "$PRIO_STATE/refresh_gen" 2>/dev/null
	: > "$PRIO_STATE/refresh.pid" 2>/dev/null
}

start_refresh() {
	local lan="$1"
	stop_refresh
	[ -e "/sys/class/net/$lan" ] || { echo "refresh:no-iface" >> "$PRIO_STATE/err"; return 0; }
	local gen
	gen="$$"
	if ! printf '%s\n' "$gen" > "$PRIO_STATE/refresh_gen" 2>/dev/null; then
		return 0
	fi
	(
		mygen="$gen"
		tick=0
		while [ "$(cat "$PRIO_STATE/refresh_gen" 2>/dev/null)" = "$mygen" ]; do
			sleep 5
			refresh_addrs "$lan"
			tick=$((tick + 1))
			# Self-heal, every 30s. A start can be lost to a racing save, a
			# reboot that ran before netifd finished, or a qdisc flushed by
			# another package. Without this the engine stays down while the
			# LuCI switch still says "enabled", which looks like the setting
			# being ignored. Reload runs detached so it can replace this loop.
			[ $((tick % 6)) -eq 0 ] || continue
			[ "$(state_get enabled)" = "1" ] || continue
			qdisc_is_ours "$lan" && continue
			now="$(date +%s 2>/dev/null)"; now="${now:-0}"
			last="$(cat "$PRIO_STATE/heal.stamp" 2>/dev/null)"; last="${last:-0}"
			case "$last" in ''|*[!0-9]*) last=0 ;; esac
			[ $((now - last)) -ge 120 ] || continue
			printf '%s\n' "$now" > "$PRIO_STATE/heal.stamp"
			logger -t luci-app-prio "watchdog: engine enabled but qdisc missing, reloading"
			( sleep 2; /etc/init.d/prio reload >/dev/null 2>&1 ) &
		done
	) </dev/null >/dev/null 2>&1 &
	echo $! > "$PRIO_STATE/refresh.pid"
	logger -t luci-app-prio "address refresh started on $lan"
}

# ---------------- bandwidth auto-detect ----------------
stop_detect() {
	local pid
	pid="$(cat "$DETECT_PID" 2>/dev/null)"
	if [ -n "$pid" ]; then
		kill "$pid" 2>/dev/null
		sleep 1
		kill -9 "$pid" 2>/dev/null
	fi
	# Park a sentinel that no live loop can match. Truncating instead would let
	# an orphaned loop (pidfile lost) keep matching an empty value and keep
	# rebuilding the qdisc after the user turned the service off.
	printf 'stopped.%s\n' "$$" > "$PRIO_STATE/detect_gen" 2>/dev/null
	: > "$DETECT_PID" 2>/dev/null
}

# ---------------- rate application ----------------
# Change only the HTB rate when the tree already exists. A full setup_downlink
# deletes the root qdisc, which drops the whole queue and stutters every TCP
# flow; rate changes are frequent, structural changes are not.
# Replace our own two lines in the status file without dropping the rows other
# writers appended in the meantime.
refresh_status_rate() {
	local key="$1" total="$2" valve="$3" st="$PRIO_STATE/status" tmp
	[ -f "$st" ] || return 0
	tmp="$st.$$"
	grep -vE "^(${key}|valve|upvalve):" "$st" > "$tmp" 2>/dev/null
	printf '%s:%skbit\n' "$key" "$total" >> "$tmp"
	if [ "$key" = "shaper" ]; then
		printf 'valve:%skbit\n' "$valve" >> "$tmp"
	else
		printf 'upvalve:%skbit\n' "$valve" >> "$tmp"
	fi
	mv "$tmp" "$st" 2>/dev/null
}

apply_rate() {
	local dev="$1" rate="$2"
	local burst valve bands
	case "$rate" in ''|*[!0-9]*) rate=0 ;; esac
	bands="$(state_get bands)"
	case "$bands" in 3|4|8) ;; *) bands=3 ;; esac
	burst=$((rate / 8 * 20))
	[ "$burst" -lt 8192 ] && burst=8192
	[ "$burst" -gt 256000 ] && burst=256000
	tc class change dev "$dev" parent 1: classid 1:100 \
		htb rate "${rate}kbit" ceil "${rate}kbit" \
		burst "${burst}b" cburst "${burst}b" 2>>"$PRIO_STATE/err"
	valve="$(valve_of "$rate")"
	set_band_valves "$dev" "$bands" "$valve"
	# The page reads these lines. An in-place change used to leave the previous
	# numbers behind until the next full rebuild, so the status row disagreed
	# with the live tree right after a measurement.
	refresh_status_rate shaper "$rate" "$valve"
}

# Either change the rate in place or, when the tree is still the
# classification-only one (no HTB root), build it properly.
apply_downlink_rate() {
	local lan="$1" bands="$2" rate="$3"
	if tc qdisc show dev "$lan" 2>/dev/null | grep -q 'qdisc htb 1: root'; then
		apply_rate "$lan" "$rate"
	else
		# setup_downlink() reads the rate through shaper_kbit(), so publish it
		# first. Without this the very first seed rebuilt a classification-only
		# tree (rate still 0), the learned value was stored but never applied,
		# and the page showed a rate while the kernel had no shaping at all.
		printf '%s\n' "$rate" > "$PRIO_STATE/shaper"
		setup_downlink "$lan" "$bands"
	fi
}

# Cumulative HTB overlimit counter for the shaped class. This is the only
# signal that says "the shaper is what is holding the link back"; throughput
# alone cannot say it, because the shaper is exactly what limits throughput.
htb_overlimits() {
	tc -s class show dev "$1" classid 1:100 2>/dev/null | \
		sed -n 's/.*overlimits \([0-9][0-9]*\).*/\1/p' | head -n1
}

# centiseconds since boot; used to normalise every sample. Without this the
# loop assumes each tick is exactly 1.000 s, but two forks plus a sleep make it
# longer, which biases every rate estimate upward.
now_cs() {
	# cut+tr: integer centiseconds, no float, no octal trap. /proc/uptime is
	# "12345.67 89.01"; stripping the dot yields centiseconds directly.
	cut -d' ' -f1 /proc/uptime 2>/dev/null | tr -d '.' || echo 0
}

# One RTT sample, in whole milliseconds. busybox ping prints a summary line
# "round-trip min/avg/max = 61.2/70.5/87.4 ms"; the MIN is what matters here:
# the average is polluted by whatever queue we are about to react to.
# Average RTT. The controller must react to a queue building up, and the
# MINIMUM hides exactly that: with an upload saturating the modem the min can
# stay at 18 ms while half the probes come back at 300 ms. The minimum is only
# used to learn the baseline.
rtt_avg_ms() {
	local target out
	target="$(state_get rtt_target)"
	[ -n "$target" ] || target=223.5.5.5
	out="$(ping -c 4 -W 2 "$target" 2>/dev/null | \
		awk -F'= ' '/round-trip/{split($2,a,"/"); print int(a[2]+0); exit}')"
	case "$out" in ''|*[!0-9]*) echo 0 ;; *) echo "$out" ;; esac
}

# Same as rtt_avg_ms, but only when every probe came back. A saturated cellular
# uplink very often answers exactly one of four pings; taking the average of
# that one reply makes a window full of queue look healthy, which is how a
# supply-limited sample passed the "modem is not queueing" test.
rtt_all_ms() {
	local target out tx rx
	target="$(state_get rtt_target)"
	[ -n "$target" ] || target=223.5.5.5
	out="$(ping -c 4 -W 2 "$target" 2>/dev/null)"
	# No leading space: busybox and iputils both print "4 packets transmitted"
	# at the start of the line, so the old '.* ' pattern never matched and this
	# function returned 0 every single time -- which silently disabled uplink
	# seeding from r65 on.
	tx="$(printf '%s\n' "$out" | sed -n 's/.*\([0-9][0-9]*\) packets transmitted.*/\1/p')"
	# busybox prints "4 packets received", iputils prints "4 received"
	rx="$(printf '%s\n' "$out" | sed -n 's/.*, \([0-9][0-9]*\) packets received.*/\1/p')"
	[ -n "$rx" ] || rx="$(printf '%s\n' "$out" | sed -n 's/.*, \([0-9][0-9]*\) received.*/\1/p')"
	tx="${tx:-0}"; rx="${rx:-0}"
	case "$tx$rx" in ''|*[!0-9]*) echo 0; return ;; esac
	[ "$tx" -gt 0 ] && [ "$rx" = "$tx" ] || { echo 0; return; }
	out="$(printf '%s\n' "$out" | awk -F'= ' '/round-trip/{split($2,a,"/"); print int(a[2]+0); exit}')"
	case "$out" in ''|*[!0-9]*) echo 0 ;; *) echo "$out" ;; esac
}

# Drop the "probe target unreachable" marker once answers are back, otherwise
# the page keeps claiming a problem that no longer exists.
clear_probe_down() {
	[ -f "$PRIO_STATE/status" ] || return 0
	grep -q '^probe:down$' "$PRIO_STATE/status" 2>/dev/null || return 0
	grep -vE '^probe:down$' "$PRIO_STATE/status" > "$PRIO_STATE/status.$$" 2>/dev/null &&
		mv "$PRIO_STATE/status.$$" "$PRIO_STATE/status" 2>/dev/null
	return 0
}

rtt_min_ms() {
	local target out
	target="$(state_get rtt_target)"
	[ -n "$target" ] || target=223.5.5.5
	out="$(ping -c 3 -W 1 "$target" 2>/dev/null | \
		awk -F'= ' '/round-trip/{split($2,a,"/"); print int(a[1]+0); exit}')"
	case "$out" in ''|*[!0-9]*) echo 0 ;; *) echo "$out" ;; esac
}

# Peak-based learning: the highest throughput the line was seen to deliver
# while the shaper was NOT the bottleneck. That is a direct measurement of
# capacity, and the safety margin decides how far below it we run. A closed
# loop that hunts for the capacity edge was tried and rejected: it either
# settled above the line (no local queue, priority dead) or collapsed to the
# floor when the path latency changed. This one only ever records what the
# line actually did.
start_detect() {
	local dev="$1" lan="$2" bands="$3"
	stop_detect
	[ "$(state_get auto_bandwidth)" = "1" ] || return 0
	[ -e "/sys/class/net/$dev" ] || { echo "detect:no-iface" >> "$PRIO_STATE/err"; return 0; }

	mkdir -p "$PRIO_STATE" 2>/dev/null
	local gen
	gen="$$"
	if ! printf '%s\n' "$gen" > "$PRIO_STATE/detect_gen" 2>/dev/null; then
		echo "detect:marker-fail" >> "$PRIO_STATE/err"
		return 0
	fi

	(
		mygen="$gen"
		busy_floor=2000
		# Everything between probes is open loop. Every probe_gap seconds the
		# shaper opens itself for about 18 seconds: that measurement is the
		# only thing that ever raises the estimate, and it is a real one -- the
		# line is free to deliver everything it can.
		#
		# Nothing ever lowers it automatically. A download from a slow server
		# is indistinguishable from a slow line from here, so an automatic
		# downward move would let any limping CDN throttle the whole
		# connection. A fresh measurement is the way down; with the automatic
		# mode off it is a manual `uci set prio.main.shaper_kbit=...`.
		# NOTE: these are seconds, and now_cs() counts centiseconds, so every
		# use below multiplies by 100. Getting this wrong made the shaper open
		# itself every 6 seconds, which is indistinguishable from no shaping.
		probe_gap=300
		next_probe=0
		downmiss=0
		upmiss=0
		mint=$(state_get measure_interval)
		case "$mint" in ''|*[!0-9]*) mint=0 ;; esac
		[ "$mint" -gt 0 ] && [ "$mint" -lt 120 ] && mint=120
		mnow=$(date +%s)
		next_meas=$(( mnow + mint ))
		link_max=0
		spd="$(cat "/sys/class/net/$dev/speed" 2>/dev/null)"
		case "$spd" in ''|*[!0-9]*) spd=0 ;; esac
		[ "$spd" -gt 0 ] && link_max=$((spd * 1000))
		[ "$link_max" -gt 0 ] || link_max=1000000
		ceiling=$((link_max * 95 / 100))

		peak=$(state_get shaper_peak)
		case "$peak" in ''|*[!0-9]*) peak=0 ;; esac
		# Older builds stored the estimate in shaper_learned, which nothing
		# writes any more. Take whichever survives so an upgrade does not
		# restart the learner from zero and throttle a healthy line.
		learned=$(state_get shaper_learned)
		case "$learned" in ''|*[!0-9]*) learned=0 ;; esac
		[ "$learned" -gt "$peak" ] && peak=$learned
		# Values measured since the last reload live in tmpfs; start() only
		# folds them into the config, this loop just keeps the best one.
		pf=$(cat "$PRIO_STATE/peak" 2>/dev/null)
		case "$pf" in ''|*[!0-9]*) pf=0 ;; esac
		# The tmpfs value is the live estimate and may be LOWER than the config
		# copy (the estimate follows the dips). Only the config copy seeds a
		# fresh boot.
		[ "$pf" -gt 0 ] && peak=$pf

		last=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null) || {
			echo "detect:no-rxbytes" >> "$PRIO_STATE/err"; exit 0; }
		last_tx=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null)
		case "$last_tx" in ''|*[!0-9]*) last_tx=0 ;; esac
		win_txb=0
		last_t=$(now_cs)
		case "$last_t" in ''|*[!0-9]*) last_t=0 ;; esac
		win_bytes=0; win_cs=0
		tick=0
		last_over=$(htb_overlimits "$lan")
		case "$last_over" in ''|*[!0-9]*) last_over=0 ;; esac

		while [ "$(cat "$PRIO_STATE/detect_gen" 2>/dev/null)" = "$mygen" ]; do
			sleep 1
			cur=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null)
			cur_tx=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null)
			case "$cur_tx" in ''|*[!0-9]*) cur_tx=0 ;; esac
			if [ "$cur_tx" -ge "$last_tx" ] && [ "$last_tx" -gt 0 ]; then
				win_txb=$(( win_txb + cur_tx - last_tx ))
			fi
			[ "$cur_tx" -gt 0 ] && last_tx=$cur_tx
			if [ -z "$cur" ]; then
				echo "detect:gone" >> "$PRIO_STATE/err"
				sleep 5
				continue
			fi
			tnow=$(now_cs)
			case "$tnow" in ''|*[!0-9]*) tnow=$last_t ;; esac
			dt=$((tnow - last_t))
			if [ "$dt" -lt 50 ]; then
				last_t=$tnow
				last=$cur
				win_txb=0
				continue
			fi
			if [ "$dt" -gt 500 ]; then
				# A stall (a slow tc call, the scheduler) must not be charged
				# to this window: drop what was accumulated instead of turning
				# the gap into a throughput figure.
				last_t=$tnow
				last=$cur
				win_bytes=0
				win_txb=0
				win_cs=0
				continue
			fi
			last_t=$tnow
			if [ "$cur" -lt "$last" ]; then
				last=$cur
				win_cs=$(( win_cs + dt ))
				continue
			fi
			win_bytes=$(( win_bytes + cur - last ))
			win_cs=$(( win_cs + dt ))
			last=$cur
			# Boundary on real elapsed time, not on a tick count: a slow tick
			# used to stretch a "20 second" window to a minute, and a probe
			# window is the shape of the whole design.
			[ "$win_cs" -ge 2000 ] || continue

			[ "$(cat "$PRIO_STATE/detect_gen" 2>/dev/null)" = "$mygen" ] || exit 0
			# real elapsed time, not the nominal 20s: ping/other work stretches
			# the window and a fixed divisor inflates the number by ~10-16%.
			if [ "$win_cs" -lt 1 ]; then
				win_bytes=0
				continue
			fi
			thr=$(( win_bytes * 8 * 100 / win_cs / 1000 ))
			thr_up=$(( win_txb * 8 * 100 / win_cs / 1000 ))
			# Snapshot every ~10 windows (a few minutes) BEFORE any of the
			# branches below can skip the rest of the window: an idle line is
			# exactly the case worth recording. Only values that exist at this
			# point are logged -- rate, latency and queue state come later in
			# the window and would print stale or empty.
			# Cheap daily check, so an idle line still ages its log out.
			diag_maybe_prune
			snap=$(( ${snap:-0} + 1 ))
			if [ "$snap" -ge 10 ]; then
				snap=0
				diag "snap rate=$(shaper_kbit) thr=${thr} thr_up=${thr_up} base=$(cat "$PRIO_STATE/rtt_base" 2>/dev/null) q=$(cat "$PRIO_STATE/queue" 2>/dev/null) bands:$(diag_bands "$lan")"
			fi
			win_bytes=0; win_txb=0; win_cs=0
			# A measurement of our own was running through this window. Its
			# bytes are not line throughput, and treating them as such would
			# make the controller cut the rate the measurement is about to
			# establish.
			if [ -f "$PRIO_STATE/measuring" ]; then
				mmage=$(( $(date +%s) - $(date -r "$PRIO_STATE/measuring" +%s 2>/dev/null || echo 0) ))
				# Only measure() used to drop a stale marker, and every path that
				# starts a measurement waits for the marker to be gone: a
				# measurement killed with SIGKILL froze the whole control loop
				# until the next reboot. The loop drops it instead.
				if [ "$mmage" -gt 120 ]; then
					rm -f "$PRIO_STATE/measuring"
				else
					thr=0
					thr_up=0
					continue
				fi
			fi
			lm=$(cat "$PRIO_STATE/last_measure" 2>/dev/null)
			case "$lm" in ''|*[!0-9]*) lm=0 ;; esac
			if [ "$lm" -gt 0 ] && [ $(( $(date +%s) - lm )) -lt 30 ]; then
				continue
			fi
			# Periodic re-measurement: capacity comes from here, never from
			# latency. Only when the line is quiet, so nobody notices.
			if [ "$mint" -ge 120 ]; then
				mnow=$(date +%s)
				if [ "$mnow" -ge "$next_meas" ] && [ "$thr" -lt 2 ] && [ "$thr_up" -eq 0 ]; then
					next_meas=$(( mnow + mint ))
					logger -t luci-app-prio "periodic measurement"
					( /etc/init.d/prio measure ) </dev/null >/dev/null 2>&1 &
				fi
			fi
			now=$(now_cs)

			# A latency-only cut may not sink the line to an unusable rate.
			# The floor used to be a flat 2 Mbit, so one long congested night
			# (or a probe target that answers slowly) could walk a 267 Mbit
			# line down to 2 Mbit and leave every band there: a reload keeps
			# the tmpfs estimate, and the 50% guard then blocked every fresh
			# measurement, so only a power cycle brought it back. 15% of what
			# the line last measured bounds the damage.
			mfl="$(state_get measured_dl)"
			case "$mfl" in ''|*[!0-9]*) mfl=0 ;; esac
			mfloor=$(( mfl * 15 / 100 ))
			[ "$mfloor" -lt 2000 ] && mfloor=2000
			mul="$(state_get measured_ul)"
			case "$mul" in ''|*[!0-9]*) mul=0 ;; esac
			ufloor=$(( mul * 15 / 100 ))
			[ "$ufloor" -lt 2000 ] && ufloor=2000

			over=$(htb_overlimits "$lan")
			case "$over" in ''|*[!0-9]*) over=0 ;; esac
			queued=0
			[ "$over" -gt "$last_over" ] && queued=1
			last_over=$over
			qtxt=none
			[ "$queued" = 1 ] && qtxt=ok
			[ "$thr" -lt "$busy_floor" ] && qtxt=idle
			printf '%s\n' "$qtxt" > "$PRIO_STATE/queue.tmp" &&
				mv "$PRIO_STATE/queue.tmp" "$PRIO_STATE/queue" 2>/dev/null

			rate=$(shaper_kbit)
			applied=$(applied_kbit "$rate")
			# A fresh install (or after a manual `uci delete` of the learned
			# rate) has no rate: 0 flows
			# through every branch and the floor turns it into 1.8 Mbit, which
			# then needs ~50 minutes of +3% to climb back. Seed it from the
			# traffic that is flowing right now instead.
			if [ "$rate" -lt 2000 ] && [ "$thr" -gt "$busy_floor" ]; then
				mseed=$(margin_pct)
				rate=$(( thr * 100 / (100 - mseed) ))
				[ "$rate" -gt "$ceiling" ] && rate=$ceiling
				if apply_downlink_rate "$lan" "$bands" "$rate"; then
					printf '%s\n' "$rate" > "$PRIO_STATE/shaper"
					logger -t luci-app-prio "rate seeded from traffic: ${rate}kbit"
				fi
			fi

			# Both directions idle: the only honest place to learn the baseline.
			# The MIN is used here (a jittery sample would inflate the floor and
			# push the controller above the real capacity), and the upload control
			# below still runs so that an upload with no download is governed.
			if [ "$thr" -lt "$busy_floor" ] && [ "$thr_up" -le 1500 ]; then
				rtt=$(rtt_min_ms)
				case "$rtt" in ''|*[!0-9]*) rtt=0 ;; esac
				if [ "$rtt" -gt 0 ]; then
					base=$(cat "$PRIO_STATE/rtt_base" 2>/dev/null)
					case "$base" in ''|*[!0-9]*) base=0 ;; esac
					bad=$(cat "$PRIO_STATE/rtt_bad" 2>/dev/null)
					case "$bad" in ''|*[!0-9]*) bad=0 ;; esac
					if [ "$base" -eq 0 ] || [ "$rtt" -lt "$base" ]; then
						printf '%s\n' "$rtt" > "$PRIO_STATE/rtt_base"
						bad=0
					elif [ "$rtt" -gt $(( base * 3 / 2 )) ]; then
						# The path got slower (new cell, new route). A baseline that
						# can only go down would then judge every window as
						# congestion and cut the rate forever.
						bad=$(( bad + 1 ))
						if [ "$bad" -ge 3 ]; then
							printf '%s\n' "$rtt" > "$PRIO_STATE/rtt_base"
							bad=0
							logger -t luci-app-prio "latency baseline reset to ${rtt}ms"
						fi
					else
						bad=0
					fi
					printf '%s\n' "$bad" > "$PRIO_STATE/rtt_bad"
				fi
			fi

			# ---- uplink control, on its own gate ----
			# It used to sit inside the download branch, so a pure upload (no
			# download) never reached it: the controller that exists to stop an
			# upload from wrecking the latency was the one thing not running.
			up=$(up_rate_kbit)
			# Auto mode: no number anywhere, so learn one -- but only from a
			# window that proves the modem was NOT queueing. tx_bytes counts
			# what the kernel handed to the modem driver, and the modem takes
			# packets and drops them instead of pushing back, so during a burst
			# this reads far above what the RF link can carry: it measures
			# supply, not delivery. A window whose own round trip is already
			# blown up is exactly that case -- the queue sits in the modem and
			# the number is meaningless. Discard it and wait for a clean one.
			if [ "$up" -lt 1000 ] && [ "$thr_up" -gt 3000 ]; then
				srtt=$(rtt_all_ms)
				case "$srtt" in ''|*[!0-9]*) srtt=0 ;; esac
				sbase=$(cat "$PRIO_STATE/rtt_base" 2>/dev/null)
				case "$sbase" in ''|*[!0-9]*) sbase=0 ;; esac
				sclean=0
				if [ "$srtt" -gt 0 ]; then
					if [ "$sbase" -gt 0 ]; then
						[ "$srtt" -le $(( sbase + 80 )) ] && sclean=1
					elif [ "$srtt" -le 150 ]; then
						# No baseline yet, so judge on the absolute value: a
						# modem queue sits near one second, a healthy line far
						# below this.
						sclean=1
					fi
				fi
				if [ "$sclean" = 1 ]; then
					printf '%s\n' "$thr_up" >> "$PRIO_STATE/uptx"
					tail -n 3 "$PRIO_STATE/uptx" > "$PRIO_STATE/uptx.tmp" 2>/dev/null &&
						mv "$PRIO_STATE/uptx.tmp" "$PRIO_STATE/uptx" 2>/dev/null
					# The middle of three windows, not the largest: one burst
					# must never become the seed. The gate is on the raw
					# sample, before the margin, otherwise a 3-5 Mbit 5G
					# uplink can never seed at all (10% margin pushed the
					# smallest useful value under the threshold).
					useed=$(sort -n "$PRIO_STATE/uptx" 2>/dev/null | sed -n 2p)
					case "$useed" in ''|*[!0-9]*) useed=0 ;; esac
					nup=$(wc -l < "$PRIO_STATE/uptx" 2>/dev/null)
					case "$nup" in ''|*[!0-9]*) nup=0 ;; esac
					if [ "$nup" -ge 3 ] && [ "$useed" -ge 3000 ]; then
						# Raw sample: the margin is applied to the
						# lower bands by apply_uplink_rate, not here.
						[ "$useed" -lt 2000 ] && useed=2000
						[ "$useed" -gt "$ceiling" ] && useed=$ceiling
						if apply_uplink_rate "$dev" "$useed"; then
							set_up_rate "$useed"
							up=$useed
							logger -t luci-app-prio "uplink seeded at ${useed}kbit (rtt ${srtt}ms, idle ${sbase}ms)"
						fi
					fi
				fi
			fi
			# A manual rate is a number the user pinned; the closed loop must
			# not move it (up or down), and the same is true for the downlink
			# when automatic learning is off. Everything below only runs in
			# automatic mode.
			manual_up=$(state_get uplink_kbit)
			case "$manual_up" in ''|*[!0-9]*) manual_up=0 ;; esac
			# Idle uplink: an old miss count would otherwise carry over and
			# make the next single lost probe look like three in a row.
			[ "$thr_up" -le 1500 ] && upmiss=0
			if [ "$up" -ge 1000 ] && [ "$thr_up" -gt 1500 ] && [ "$manual_up" -lt 1000 ]; then
				urtt=$(rtt_avg_ms)
				base=$(cat "$PRIO_STATE/rtt_base" 2>/dev/null)
				case "$base" in ''|*[!0-9]*) base=0 ;; esac
				case "$urtt" in ''|*[!0-9]*) urtt=0 ;; esac
				# Same protection as the downlink: three windows in a row with
				# no answer at all mean the probe target is unusable (wrong
				# address, ICMP filtered), not that the line is slow. Without
				# it the uplink walked itself to the 2 Mbit floor at -15% per
				# window and stayed there, unreachable except by restarting.
				if [ "$urtt" -eq 0 ]; then
					upmiss=$(( upmiss + 1 ))
				else
					upmiss=0
					clear_probe_down
				fi
				if [ "$upmiss" -ge 3 ]; then
					grep -q 'probe:down' "$PRIO_STATE/status" 2>/dev/null ||
						echo "probe:down" >> "$PRIO_STATE/status"
				fi
				if [ "$upmiss" -lt 3 ]; then
					# Knee model, same as the downlink: raise while the round
					# trip is only cell jitter, cut when the queue appears
					# somewhere, hold in between. Cuts are never gated on
					# anything, so a capacity drop always comes back down.
					newup=$up
					if [ "$urtt" -eq 0 ]; then
						newup=$(( up * 85 / 100 ))
					elif { [ "$base" -gt 0 ] && [ "$urtt" -gt $(( base + 300 )) ]; } ||
					     { [ "$base" -eq 0 ] && [ "$urtt" -gt 200 ]; }; then
						# same proportional cut as the downlink
						uex=$(( urtt - base ))
						[ "$base" -eq 0 ] && uex=$urtt
						ustep=$(( 10 + (uex - 300) / 40 ))
						[ "$ustep" -gt 30 ] && ustep=30
						[ "$ustep" -lt 10 ] && ustep=10
						newup=$(( up * (100 - ustep) / 100 ))
						# no automatic raise here either: measure() seeds the
						# uplink, latency only cuts it
					fi
					[ "$newup" -lt "$ufloor" ] && newup=$ufloor
					if [ "$newup" -ne "$up" ]; then
						if apply_uplink_rate "$dev" "$newup"; then
							set_up_rate "$newup"
							logger -t luci-app-prio "uplink ${up} -> ${newup}kbit (rtt ${urtt}ms, idle ${base}ms)"
							diag "cut-up uplink ${up} -> ${newup} thr_up=${thr_up} rtt=${urtt} base=${base} floor=${ufloor}"
						fi
					fi
				fi
			fi

			if [ "$thr" -lt "$busy_floor" ]; then
				continue
			fi

			# ---- rate control on measured latency ----
			# Throughput is useless as a control signal here: this cell moved
			# from 160 to 8 Mbit/s inside an hour, and a download from a slow
			# server looks exactly like a slow line. Latency does not have that
			# problem. Measured on the router itself, same traffic:
			#     cap 20000 -> 1068 ms average
			#     cap  8000 ->   32 ms average
			# So with traffic flowing: round trip near the idle baseline means the
			# shaper sits below the real capacity and can be raised a little;
			# a blown-up round trip means the queue is inside the modem and the
			# cap has to come down.
			rtt=$(rtt_avg_ms)
			case "$rtt" in ''|*[!0-9]*) rtt=0 ;; esac
			base=$(cat "$PRIO_STATE/rtt_base" 2>/dev/null)
			case "$base" in ''|*[!0-9]*) base=0 ;; esac
			# base+15 was a dead zone 45 ms wide: with a jittery cellular line the
			# round trip usually landed inside it and the controller did nothing
			# at all, which is neither "below capacity" nor "over it". The raise
			# window now scales with the baseline, and the cut is proportional.
			# Three windows in a row with no answer at all means the probe target
			# is unusable (wrong address, ICMP filtered), not that the line is
			# slow. Hold the rate instead of walking it to the floor and
			# persisting that across reboots.
			if [ "$rtt" -eq 0 ]; then
				downmiss=$(( downmiss + 1 ))
			else
				downmiss=0
				clear_probe_down
			fi
			bind=0
			if [ "$applied" -ge 1000 ] && [ $(( thr * 100 )) -ge $(( applied * 80 )) ]; then
				bind=1
			fi
			if [ "$downmiss" -ge 3 ]; then
				grep -q 'probe:down' "$PRIO_STATE/status" 2>/dev/null ||
					echo "probe:down" >> "$PRIO_STATE/status"
				# A dead target and a modem queued past the probe timeout look
				# identical: no answer at all. Freezing is only safe when the
				# traffic says the cap is NOT binding; if the download is
				# running at the cap and nothing answers, that is the queue.
				# Nothing has answered for three windows: either the target is
				# filtered or the modem is queued past the probe timeout. Either
				# way the rate is now a guess, so ask for a measurement instead
				# of walking to the 1800 kbit floor and staying there.
				lm3=$(cat "$PRIO_STATE/last_measure" 2>/dev/null)
				case "$lm3" in ''|*[!0-9]*) lm3=0 ;; esac
				if [ $(( $(date +%s) - lm3 )) -gt 600 ] && [ ! -f "$PRIO_STATE/measuring" ]; then
					( sleep 5; /etc/init.d/prio measure ) </dev/null >/dev/null 2>&1 &
					logger -t luci-app-prio "probe dead, re-measuring instead of cutting"
				fi
				if [ "$bind" = 1 ]; then
					newrate=$(( rate * 90 / 100 ))
					[ "$newrate" -lt "$mfloor" ] && newrate=$mfloor
					if apply_downlink_rate "$lan" "$bands" "$newrate"; then
						printf '%s\n' "$newrate" > "$PRIO_STATE/shaper"
						logger -t luci-app-prio "rate ${rate} -> ${newrate}kbit (probe unanswered at the cap)"
					diag "cut(probe) rate ${rate} -> ${newrate} thr=${thr} rtt=${rtt} base=${base} bands:$(diag_bands "$lan")"
					fi
				fi
				continue
			fi
			newrate=$rate
			mref0=$(state_get measured_dl)
			case "$mref0" in ''|*[!0-9]*) mref0=0 ;; esac
			# Two thresholds, a wide band between them, and no "is the shaper
			# the bottleneck" gate:
			#  * below knee_lo the round trip is the cell's normal jitter,
			#    whatever the rate, so raising is safe;
			#  * above knee_hi the queue is somewhere (ours or the modem's),
			#    so cutting is right -- and a cut must never be gated on
			#    anything, or a capacity drop freezes the rate above capacity;
			#  * in between, hold. That band is below the queueing regime
			#    (measured here: jitter 34-94 ms, modem queue 300-1000 ms), so
			#    holding in it costs almost nothing.
			# A "binding" test was tried and rejected: with the real capacity
			# below the applied rate the measured throughput can never reach
			# 80% of it, so the gate stayed closed and the rate never came down.
			if [ "$rtt" -eq 0 ]; then
				newrate=$(( rate * 80 / 100 ))
			elif { [ "$base" -gt 0 ] && [ "$rtt" -gt $(( base + 300 )) ]; } ||
			     { [ "$base" -eq 0 ] && [ "$rtt" -gt 200 ] &&
			       { [ "$mref0" -lt 1000 ] || [ "$rate" -gt $(( mref0 * 4 / 10 )) ]; }; }; then
				# If the estimate has fallen far below what the line last
				# measured, this is not a transient queue any more: schedule a
				# fresh measurement (rate limited to once per 10 minutes).
				mref=$(state_get measured_dl)
				case "$mref" in ''|*[!0-9]*) mref=0 ;; esac
				if [ "$mref" -ge 1000 ] && [ "$rate" -lt $(( mref * 70 / 100 )) ]; then
					lmr=$(cat "$PRIO_STATE/last_measure" 2>/dev/null)
					case "$lmr" in ''|*[!0-9]*) lmr=0 ;; esac
					if [ $(( $(date +%s) - lmr )) -gt 600 ] && [ ! -f "$PRIO_STATE/measuring" ]; then
						( sleep 5; /etc/init.d/prio measure ) </dev/null >/dev/null 2>&1 &
						logger -t luci-app-prio "rate fell well below the last measurement, re-measuring"
					fi
				fi
				# Cut in proportion to how far the queue sits beyond the
				# baseline: -10% for a small overshoot, -30% for a blown-up one.
				# The previous ratio was a constant -30% for every base below
				# ~567 ms (the ratio could never exceed 0.70), which made the
				# loop a bang-bang oscillator instead of a controller.
				ex=$(( rtt - base ))
				[ "$base" -eq 0 ] && ex=$rtt
				step=$(( 10 + (ex - 300) / 40 ))
				[ "$step" -gt 30 ] && step=30
				[ "$step" -lt 10 ] && step=10
				newrate=$(( rate * (100 - step) / 100 ))
				# Nothing here ever raises the rate. Capacity comes from
				# measure(); this loop only takes capacity away when the
				# queue shows up. That is the whole point of r71: a raise
				# needs evidence, and latency is not evidence of capacity --
				# three audits found a different way for it to run away.
			fi
			[ "$newrate" -gt "$ceiling" ] && newrate=$ceiling
			[ "$newrate" -lt "$mfloor" ] && newrate=$mfloor
			if [ "$newrate" -ne "$rate" ]; then
				if apply_downlink_rate "$lan" "$bands" "$newrate"; then
					printf '%s\n' "$newrate" > "$PRIO_STATE/shaper"
					printf '%s\n' "$newrate" > "$PRIO_STATE/peak"
					peak=$newrate
					logger -t luci-app-prio "rate ${rate} -> ${newrate}kbit (rtt ${rtt}ms, idle ${base}ms)"
					diag "cut rate ${rate} -> ${newrate} thr=${thr} rtt=${rtt} base=${base} floor=${mfloor} bands:$(diag_bands "$lan")"
				fi
			fi

			continue

		done
	) </dev/null >/dev/null 2>&1 &
	echo $! > "$DETECT_PID"
	logger -t luci-app-prio "bandwidth auto-detect started on $dev (capacity peak, pid $(cat "$DETECT_PID"))"
}

# Whether the shaped class was over its rate is read from the qdisc's own
# cumulative overlimit counter (htb_overlimits, above), never from interface
# counters: rx_bytes on WAN is the *offer* -- packets the shaper will drop,
# retransmissions and other clients are all in it -- so it can never prove
# that a given rate was the bottleneck.

# The closer the probe target, the cleaner the signal: a hop inside the ISP's
# own network shows the access link's queue immediately, while a far target
# mixes in that server's path. Walk the route, skip the gateway, and take the
# first few hops that answer, preferring the fastest one.
pickprobe() {
	local seed out cands best bestrtt ip r loss
	seed="$(state_get probe_seed)"
	[ -n "$seed" ] || seed=223.5.5.5
	command -v traceroute >/dev/null 2>&1 || {
		echo "no traceroute" > "$PRIO_STATE/probe.txt"
		return 1
	}
	out="$(traceroute -n -w 1 -q 1 -m 8 "$seed" 2>/dev/null)"

	# Collect the fastest few hops that answer the traceroute, then keep only
	# the ones that also answer a plain ping. The first hop is the ISP's
	# gateway and usually drops ICMP echo, which makes it useless as a probe.
	cands="$(printf '%s\n' "$out" | awk '
		BEGIN { best = 99999 }
		$2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $4 == "ms" &&
		$1 >= 3 && $1 <= 7 && $3 + 0 < 80 {
			n++; ip[n] = $2; r[n] = $3 + 0
		}
		END {
			for (i = 1; i <= n; i++)
				for (j = i + 1; j <= n; j++)
					if (r[j] < r[i]) {
						t = r[i]; r[i] = r[j]; r[j] = t
						tt = ip[i]; ip[i] = ip[j]; ip[j] = tt
					}
			for (i = 1; i <= n && i <= 4; i++) print ip[i], r[i]
		}')"

	best=""
	while read -r ip r; do
		[ -n "$ip" ] || continue
		loss="$(ping -c 4 -W 1 "$ip" 2>/dev/null | \
			sed -n 's/.*received, \([0-9][0-9]*\)% packet loss.*/\1/p')"
		if [ "$loss" = "0" ]; then
			best="$ip"; bestrtt="$r"
			break
		fi
	done <<EOF
$cands
EOF

	if [ -z "$best" ]; then
		echo "附近没有既能追踪又能 ping 通的节点，保持原目标。" > "$PRIO_STATE/probe.txt"
		return 1
	fi
	printf '探测目标已设为 %s（traceroute %s ms，ping 无丢包）\n' "$best" "$bestrtt" \
		> "$PRIO_STATE/probe.txt"
	state_set rtt_target "$best"
	logger -t luci-app-prio "probe target -> $best (${bestrtt}ms)"
	echo "$best"
	return 0
}

# ---------------------------------------------------------------------------
# measure: find the line's capacity by actually using it.
#
# The one thing the latency loop can never learn is how much the line can carry:
# latency says "there is a queue", never "these bits fit". So capacity comes
# from a measurement -- the router downloads and uploads through its own
# unshaped class (traffic this router originates is unmarked, so it lands in
# 1:1 at 10 Gbit and never touches the shaped class) and counts the bytes on
# the WAN interface while it runs. Latency keeps its own job: taking capacity
# away when the queue appears.
# ---------------------------------------------------------------------------
measure() {
	local dev dl_url ul_url secs a b dl ul f p1 p2 p3 p4
	local method node lat force
	force="$1"
	dev="$(cat "$PRIO_STATE/dev" 2>/dev/null)"
	[ -n "$dev" ] || dev="$(state_get wan_iface)"
	[ -n "$dev" ] || dev=eth2
	dl_url="$(state_get measure_url)"
	[ -n "$dl_url" ] || dl_url="https://mirrors.ustc.edu.cn/ubuntu-releases/24.04/ubuntu-24.04.3-live-server-amd64.iso"
	ul_url="$(state_get measure_up_url)"
	[ -n "$ul_url" ] || ul_url="https://speed.cloudflare.com/__up"
	secs="$(state_get measure_secs)"
	case "$secs" in ''|*[!0-9]*) secs=5 ;; esac
	[ "$secs" -lt 2 ] && secs=2
	[ "$secs" -gt 15 ] && secs=15
	method="$(state_get measure_method)"
	[ -n "$method" ] || method=auto
	# Cleared up front: the early exits below record a reason through mea_fail,
	# which would otherwise reuse the reading left by an earlier phase.
	MEASURE_NOW=""

	[ -e "/sys/class/net/$dev/statistics/rx_bytes" ] || { echo "measure:no-iface"; mea_fail no-iface; return 1; }
	# A detached run outlives the click that started it, so it must refuse to
	# spend hundreds of megabytes for a plugin the user has just switched off.
	if [ "$(state_get enabled)" != "1" ]; then
		echo "measure:disabled"
		mea_fail disabled
		logger -t luci-app-prio "measurement skipped: the engine is off"
		return 1
	fi

	# Two measurements at once would each see the other's traffic; the marker
	# also tells the detector to ignore its window. It is cleaned by a trap:
	# leaving it behind (this function is the only unguarded one in the script)
	# stops the control loop entirely until the next successful measurement or
	# a reboot, because the detector skips every window while it exists.
	if [ -f "$PRIO_STATE/measuring" ]; then
		local mage
		mage=$(( $(date +%s) - $(date -r "$PRIO_STATE/measuring" +%s 2>/dev/null || echo 0) ))
		# a marker older than this cannot belong to a live measurement
		[ "$mage" -gt 120 ] && rm -f "$PRIO_STATE/measuring" || { echo "measure:busy"; mea_fail busy; return 1; }
	fi
	: > "$PRIO_STATE/measuring"
	trap 'rm -f "$PRIO_STATE/measuring"; : > /tmp/.prio-measure-up 2>/dev/null; : > /tmp/.prio-cnspeed.json 2>/dev/null' EXIT INT TERM

	# Only measure an idle line. The counters are per-interface, so any other
	# client using the link at the same time lands in the same sum -- measuring
	# during someone else's download reported 433 Mbit on a 200 Mbit line and
	# pushed the shaper above the capacity, which is exactly the failure that
	# makes priority useless.
	local i0 i1 bobs bthr
	i0=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null)
	sleep 2
	i1=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null)
	case "$i0$i1" in ''|*[!0-9]*) ;; *)
		bobs=$(( (i1 - i0) * 8 / 2 / 1000 ))
		# Proportional threshold. A flat 2000 kbit/s was 10% of the 20 Mbit
		# line this feature was written for, but only 0.8% of a 267 Mbit
		# line: there, a phone scrolling a feed already exceeds it and the
		# button can never run. 2% of the last estimate keeps the guard real
		# while letting ordinary background traffic through.
		bthr=$(( $(shaper_kbit) / 50 ))
		[ "$bthr" -lt 2000 ] && bthr=2000
		if [ "$bobs" -gt "$bthr" ]; then
			echo "measure:busy"
			logger -t luci-app-prio "measurement skipped: link is busy (${bobs} kbit/s > ${bthr})"
			mea_fail line-busy "$bobs" "$bthr"
			return 1
		fi
		;;
	esac

	dl=0; ul=0; node=""
	# Preferred source: the CN speedtest client this firmware already ships
	# (cnspeedtest). It discovers a mainland node -- Guangzhou/Shenzhen Unicom
	# here -- and runs 8 parallel TCP streams, which is what makes the number
	# usable: the mirror + Cloudflare combination the script used before crosses
	# an international path and reported 185/35 Mbit on a line that this tool
	# measures at 395-505 down and 100-112 up.
	if [ "$method" != "http" ] && [ -x /usr/bin/cnspeedtest ] && command -v jq >/dev/null 2>&1; then
		f=/tmp/.prio-cnspeed.json
		if timeout $(( secs * 4 + 40 )) /usr/bin/cnspeedtest -web=false -json \
			-duration "${secs}s" -download-threads 8 -upload-threads 4 > "$f" 2>/dev/null &&
			[ -s "$f" ]; then
			dl=$(jq -r '.download.AvgMbps // 0' "$f" 2>/dev/null)
			ul=$(jq -r '.upload.AvgMbps // 0' "$f" 2>/dev/null)
			node=$(jq -r '.node.name // ""' "$f" 2>/dev/null)
			lat=$(jq -r '.latency_ms.avg // 0' "$f" 2>/dev/null)
			dl=$(awk -v v="${dl:-0}" 'BEGIN{printf "%d", v*1000}')
			ul=$(awk -v v="${ul:-0}" 'BEGIN{printf "%d", v*1000}')
		fi
		: > "$f"
	fi

	if [ "${dl:-0}" -lt 1000 ] && [ "${ul:-0}" -lt 1000 ]; then
		# Fallback: plain HTTP through this router's own unshaped path.
		method=http
		# --- download ---
		# Start the transfer first and only then start counting: the first second
		# is TCP slow start, and timing it as if it were the line made a 185 Mbit
		# link measure as 65 Mbit.
		curl -s -o /dev/null --max-time $((secs + 10)) "$dl_url" 2>/dev/null & p1=$!
		curl -s -o /dev/null --max-time $((secs + 10)) "$dl_url" 2>/dev/null & p2=$!
		curl -s -o /dev/null --max-time $((secs + 10)) "$dl_url" 2>/dev/null & p3=$!
		curl -s -o /dev/null --max-time $((secs + 10)) "$dl_url" 2>/dev/null & p4=$!
		sleep 3
		a=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null)
		case "$a" in ''|*[!0-9]*) a=0 ;; esac
		sleep "$secs"
		kill "$p1" "$p2" "$p3" "$p4" 2>/dev/null
		wait 2>/dev/null
		b=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null)
		case "$b" in ''|*[!0-9]*) b=0 ;; esac
		if [ "$b" -gt "$a" ]; then dl=$(( (b - a) * 8 / 1000 / secs )); else dl=0; fi

		# --- upload ---
		f=/tmp/.prio-measure-up
		dd if=/dev/zero of="$f" bs=1048576 count=12 2>/dev/null
		curl -s -o /dev/null --max-time $((secs + 20)) -X POST --data-binary @"$f" "$ul_url" 2>/dev/null & p1=$!
		curl -s -o /dev/null --max-time $((secs + 20)) -X POST --data-binary @"$f" "$ul_url" 2>/dev/null & p2=$!
		curl -s -o /dev/null --max-time $((secs + 20)) -X POST --data-binary @"$f" "$ul_url" 2>/dev/null & p3=$!
		sleep 3
		a=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null)
		case "$a" in ''|*[!0-9]*) a=0 ;; esac
		at=$(date +%s)
		# Wait for the window, but stop early when the transfers are done: the
		# three flows carry a fixed amount of data, and on a fast line they
		# finish long before the window ends. Dividing that amount by the window
		# (instead of by the time it actually took) reported 10 Mbit on an 80
		# Mbit link.
		waitn=0
		while [ "$waitn" -lt "$secs" ]; do
			sleep 1
			waitn=$(( waitn + 1 ))
			kill -0 "$p1" 2>/dev/null || kill -0 "$p2" 2>/dev/null || kill -0 "$p3" 2>/dev/null || break
		done
		bt=$(date +%s)
		kill "$p1" "$p2" "$p3" 2>/dev/null
		wait 2>/dev/null
		b=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null)
		case "$b" in ''|*[!0-9]*) b=0 ;; esac
		uel=$(( bt - at ))
		[ "$uel" -lt 1 ] && uel=1
		if [ "$b" -gt "$a" ]; then ul=$(( (b - a) * 8 / 1000 / uel )); else ul=0; fi
		: > "$f"
	fi

	printf '%s %s %s %s\n' "$dl" "$ul" "$(date +%s)" "$node" > "$PRIO_STATE/measure.txt" 2>/dev/null
	# The round trip right after a full-speed measurement is not a fair sample
	# (the modem is still draining), and judging it made the controller cut the
	# rate the measurement had just established. Give it half a minute.
	printf '%s\n' "$(date +%s)" > "$PRIO_STATE/last_measure" 2>/dev/null
	rm -f "$PRIO_STATE/measuring" 2>/dev/null
	printf 'down=%skbit up=%skbit via=%s node=%s\n' "$dl" "$ul" "$method" "$node"

	# A measurement below 1 Mbit means the measurement failed (no route, the
	# URL moved, the line was busy), not that the line is that slow. Keep the
	# previous numbers rather than pinning the shaper to a bogus value.
	# A single sample sets the cap for every device, so a number far below what
	# the line did recently is not trusted: a mirror throttling this IP, a busy
	# moment or a truncated transfer must not pin the shaper to a tenth of the
	# line and leave no way back (nothing in the control loop raises the rate).
	# A real collapse still comes down, because the latency loop cuts on its own.
	prev_dl="$(state_get measured_dl)"
	case "$prev_dl" in ''|*[!0-9]*) prev_dl=0 ;; esac
	prev_at="$(state_get measured_at)"
	case "$prev_at" in ''|*[!0-9]*) prev_at=0 ;; esac
	# One reading for both the guard notes and the timestamps below: taking two
	# let the second tick over in between, and the note then looked older than
	# the measurement it belongs to and was hidden.
	MEASURE_NOW="$(date +%s)"
	guard_reject=0
	guard_reject_up=0
	# "measure force" is what the page's button sends: the guard above exists to
	# stop an AUTOMATIC re-measure from pinning a throttled sample, but a user
	# pressing the button has just looked at the connection and wants the line
	# measured again. Without this the guard also blocked the only way out of a
	# crashed estimate (every recovery attempt was "under half").
	if [ "$force" = "force" ]; then
		guard_reject=0
	elif [ "$dl" -ge 1000 ] && [ "$prev_dl" -ge 5000 ] &&
	   [ $(( $(date +%s) - prev_at )) -lt 86400 ] &&
	   [ "$dl" -lt $(( prev_dl * 50 / 100 )) ]; then
		logger -t luci-app-prio "measurement ${dl}kbit is under half of ${prev_dl}kbit, ignored"
		dl=$prev_dl
		guard_reject=1
		mea_fail rejected
	fi
	# The upload leg needs the same sanity check, and for a harder reason: an
	# upload measurement that lands on a busy or badly peered node reports a
	# fraction of the real rate, and since nothing in the control loop raises
	# the uplink, one such sample pins the upload for good. That happened here
	# -- 13 Mbit stored against a previous 133 -- and kept the uplink at 12.
	prev_ul="$(state_get measured_ul)"
	case "$prev_ul" in ''|*[!0-9]*) prev_ul=0 ;; esac
	# Its OWN timestamp, not measured_at: that one describes the download and is
	# refreshed by every accepted download, so using it here would restart this
	# window on every good download and a genuine upload downgrade could never
	# be accepted. An empty key (fresh install, upgrade) leaves the guard inert
	# for one run, which is the safe direction.
	prev_ul_at="$(state_get measured_at_up)"
	case "$prev_ul_at" in ''|*[!0-9]*) prev_ul_at=0 ;; esac
	if [ "$force" != "force" ] && [ "$ul" -ge 1000 ] && [ "$prev_ul" -ge 5000 ] &&
	   [ "$prev_ul_at" -gt 0 ] &&
	   [ $(( $(date +%s) - prev_ul_at )) -lt 86400 ] &&
	   [ "$ul" -lt $(( prev_ul * 50 / 100 )) ]; then
		logger -t luci-app-prio "upload ${ul}kbit is under half of ${prev_ul}kbit, ignored"
		ul=$prev_ul
		guard_reject_up=1
		mea_fail rejected-up
	fi
	dlok=0; ulok=0
	[ "$dl" -ge 1000 ] && dlok=1
	[ "$ul" -ge 1000 ] && ulok=1
	if [ "$dlok" = 0 ] && [ "$ulok" = 0 ]; then
		logger -t luci-app-prio "measurement failed (down ${dl} up ${ul} kbit)"
		diag "measure failed dl=${dl} ul=${ul} method=${method:-?}"
		mea_fail no-data
		return 1
	fi
	[ "$dlok" = 1 ] || dl="$(state_get measured_dl)"
	[ "$ulok" = 1 ] || ul="$(state_get measured_ul)"

	acquire_lock || {
		# store the numbers even without the lock; the next start() will use them
		state_set measured_dl "$dl"
		state_set measured_ul "$ul"
		# Same rules as below: only a real download measurement may refresh the
		# timestamp, and a rejected result must not clear the failure note.
		if [ "$dlok" = 1 ] && [ "$guard_reject" != 1 ]; then
			state_set measured_at "$MEASURE_NOW"
		fi
		if [ "$ulok" = 1 ] && [ "$guard_reject_up" != 1 ]; then
			state_set measured_at_up "$MEASURE_NOW"
		fi
		[ "$guard_reject" = 1 ] || [ "$guard_reject_up" = 1 ] || mea_ok
		return 0
	}
	diag "measure stored dl=${dl} ul=${ul} force=${force:-no}"
	state_set measured_dl "$dl"
	state_set measured_ul "$ul"
	# A stored number clears the previous failure note; a rejected one keeps it,
	# because nothing was learned and the page should still say why.
	[ "$guard_reject" = 1 ] || [ "$guard_reject_up" = 1 ] || mea_ok
	# The timestamp describes the DOWNLOAD number (that is what the shaper uses
	# and what the freshness checks read), so a failed download must not renew
	# it -- otherwise an old value looks fresh forever.
	# A result the guard above threw away must not renew it either: the guard
	# reads this timestamp, so renewing it restarted the 24 h window on every
	# rejected attempt and a genuinely slower line could never be accepted.
	if [ "$dlok" = 1 ] && [ "$guard_reject" != 1 ]; then
		state_set measured_at "$MEASURE_NOW"
	fi
	# ... and its upload counterpart describes the UPLOAD number, for the same
	# reason: it must only move when the upload was actually believed.
	if [ "$ulok" = 1 ] && [ "$guard_reject_up" != 1 ]; then
		state_set measured_at_up "$MEASURE_NOW"
	fi
	# A fresh measurement replaces the rate, so the latency floor learned on
	# the old path has to go with it: a stale baseline judges the new rate as
	# congestion and cuts it for several windows before it re-learns. Truncated
	# rather than deleted -- an empty file reads as 0, which is "not learned
	# yet", and the loop takes a new sample from the next idle window.
	# A rejected sample tells us nothing about the path, so it must not reset
	# the baseline either -- the loop is still using it.
	if [ "$dlok" = 1 ] && [ "$guard_reject" != 1 ]; then
		: > "$PRIO_STATE/rtt_base"
		: > "$PRIO_STATE/rtt_bad"
	fi
	# A measurement that finished after the engine was stopped must not rebuild
	# the queue it just tore down.
	if [ "$(state_get enabled)" != "1" ]; then
		release_lock
		return 0
	fi
	# guard_reject: dl is the OLD number here, so applying it would overwrite the
	# live cut the control loop made with a value the guard just called untrusted.
	if [ "$(state_get auto_bandwidth)" = "1" ] && [ "$dlok" = 1 ] &&
	   [ "$guard_reject" != 1 ]; then
		# In automatic mode the measurement is the estimate. shaper_margin is
		# applied on top of it when the rate is handed to tc, so the shaped
		# value ends up at (100 - margin)% of what the line just delivered.
		state_set shaper_learned "$dl"
		printf '%s\n' "$dl" > "$PRIO_STATE/shaper" 2>/dev/null
		printf '%s\n' "$dl" > "$PRIO_STATE/peak" 2>/dev/null
		local bands lan
		bands="$(state_get bands)"; case "$bands" in 3|4|8) ;; *) bands=3 ;; esac
		lan="$(cat "$PRIO_STATE/lan" 2>/dev/null)"; [ -n "$lan" ] || lan="$(state_get lan_iface)"
		apply_downlink_rate "$lan" "$bands" "$dl"
		# A pinned uplink rate wins over the measurement.
		local mup
		mup="$(state_get uplink_kbit)"
		case "$mup" in ''|*[!0-9]*) mup=0 ;; esac
		# guard_reject_up: the number is the OLD one, re-applying it would
		# overwrite the live cut the control loop made and raise the uplink.
		if [ "$ulok" = 1 ] && [ "$guard_reject_up" != 1 ] &&
		   [ "$ul" -ge 1000 ] && [ "$mup" -lt 1000 ] && [ "$(state_get uplink)" = "1" ]; then
			# The measured upload is the total gate. apply_uplink_rate()
			# derives the lower-band valve from it, so the margin is no
			# longer taken off here.
			local ulshape
			ulshape=$ul
			[ "$ulshape" -lt 2000 ] && ulshape=2000
			[ "$ulshape" -gt 200000 ] && ulshape=200000
			state_set uplink_learned "$ulshape"
			if apply_uplink_rate "$dev" "$ulshape"; then
				set_up_rate "$ulshape"
			fi
		fi
	fi
	release_lock
	logger -t luci-app-prio "measured down ${dl}kbit up ${ul}kbit via ${method} ${node}"
	return 0
}


# ---------------- main ----------------
start() {
	config_load prio
	config_get_bool enabled main enabled 0
	# Nothing has been touched yet, so returning is safe: reload() no longer
	# tears anything down before calling start(). Calling stop() here would be
	# worse -- a single stale read of the config would dismantle a healthy
	# engine that the user never asked to turn off.
	[ "$enabled" = 1 ] || return 0;

	mkdir -p "$PRIO_STATE" 2>/dev/null
	acquire_lock || return 1

	# One-shot migration from the old "margin on the total" model. The stored
	# uplink numbers were already reduced by the margin; the new model stores
	# the raw capacity and takes the margin off the lower bands only. Scaling
	# them back once keeps the first window after the upgrade at the same real
	# rate instead of losing the margin twice.
	if [ ! -f "$PRIO_STATE/ratemodel" ]; then
		local mp ulv urv
		mp="$(margin_pct)"
		ulv="$(state_get uplink_learned)"
		case "$ulv" in ''|*[!0-9]*) ulv=0 ;; esac
		if [ "$ulv" -ge 1000 ]; then
			state_set uplink_learned $(( ulv * 100 / (100 - mp) ))
		fi
		urv="$(cat "$PRIO_STATE/up_rate" 2>/dev/null)"
		case "$urv" in ''|*[!0-9]*) urv=0 ;; esac
		if [ "$urv" -ge 1000 ]; then
			printf '%s\n' $(( urv * 100 / (100 - mp) )) > "$PRIO_STATE/up_rate" 2>/dev/null
		fi
		printf '2\n' > "$PRIO_STATE/ratemodel" 2>/dev/null
	fi
	: > "$PRIO_STATE/status"
	: > "$PRIO_STATE/err"
	: > "$PRIO_STATE/ipmap"
	: > "$PRIO_STATE/macmap"
	: > "$PRIO_STATE/addrseen"
	[ -f "$PRIO_STATE/shaper" ] || : > "$PRIO_STATE/shaper"

	local bands uplink downlink dev lan auto_fp auto_bw
	config_get bands main bands 3
	case "$bands" in 3|4|8) ;; *) bands=3 ;; esac
	config_get_bool uplink   main uplink 1
	config_get_bool downlink main downlink 1
	config_get dev main wan_iface eth2
	config_get lan main lan_iface br-lan
	config_get_bool auto_fp main auto_hnat_off 1
	config_get_bool auto_bw main auto_bandwidth 1

	# Fold the tmpfs estimate into the config, here and only here: this point
	# holds the lock, while the background detector does not. Its uci commit
	# used to rewrite the whole file and could resurrect the auto_bandwidth
	# value from before a save (observed: auto flipped back to 1).
	local pf lf
	pf="$(cat "$PRIO_STATE/peak" 2>/dev/null)"
	case "$pf" in ''|*[!0-9]*) pf=0 ;; esac
	lf="$(state_get shaper_learned)"
	case "$lf" in ''|*[!0-9]*) lf=0 ;; esac
	# The uplink controller keeps its live value in tmpfs, which a reboot wipes.
	# uplink_kbit=0 means AUTOMATIC in this build, not "off", so the learned
	# value has to survive a save/reload here -- otherwise every "apply" dropped
	# the uplink back to the open 1 Gbit tree (queue into the modem, priority
	# dead) and the page still claimed it was measuring.
	local upcfg ul uf
	upcfg="$(state_get uplink_kbit)"
	case "$upcfg" in ''|*[!0-9]*) upcfg=0 ;; esac
	uf="$(cat "$PRIO_STATE/up_rate" 2>/dev/null)"
	case "$uf" in ''|*[!0-9]*) uf=0 ;; esac
	ul="$(state_get uplink_learned)"
	case "$ul" in ''|*[!0-9]*) ul=0 ;; esac
	if [ "$upcfg" -ge 1000 ]; then
		# A manual rate is the user's decision and is used verbatim. Seed the
		# live value from it (the loop may trim it) and forget anything learned
		# under a different config, so a higher learned value can never shadow it.
		set_up_rate "$upcfg"
		uf=$upcfg
		: > "$PRIO_STATE/uptx"
		[ "$ul" -gt 0 ] && state_set uplink_learned ""
	elif [ "$uf" -lt 1000 ] && [ "$ul" -ge 2000 ]; then
		# Fresh boot: start shaping at the rate learned last time instead of
		# running open for the first three windows.
		set_up_rate "$ul"
		uf=$ul
	elif [ "$uf" -ge 2000 ] && [ "$uf" -ne "$ul" ]; then
		state_set uplink_learned "$uf"
	fi

	# Deleting the learned keys by hand (first install, or `uci delete`) must not
	# let anything left in tmpfs resurrect them on the next start.
	if [ -z "$(state_get shaper_learned)" ] && [ -z "$(state_get shaper_peak)" ]; then
		: > "$PRIO_STATE/peak"
		: > "$PRIO_STATE/probes"
	elif [ "$pf" -ge 5000 ] && [ "$pf" -ne "$lf" ]; then
		state_set shaper_learned "$pf"
		state_set shaper_peak "$pf"
	fi

	# With auto-detection off the UCI value is authoritative. Also drop the
	# learned rate when the WAN interface changed: a rate measured on the old
	# uplink would be wrong on the new one and would never self-correct.
	if [ "$auto_bw" != 1 ] || [ "$(cat "$PRIO_STATE/dev" 2>/dev/null)" != "$dev" ]; then
		: > "$PRIO_STATE/shaper" 2>/dev/null
	fi
	# A rate learned on the previous uplink is meaningless on the new one, so
	# drop the persisted copy too -- but only when the interface really changed.
	if [ -n "$(cat "$PRIO_STATE/dev" 2>/dev/null)" ] &&
	   [ "$(cat "$PRIO_STATE/dev" 2>/dev/null)" != "$dev" ]; then
		state_set shaper_learned ""
		# Both keys: the detector starts from whichever is larger, so leaving
		# the peak behind would keep the old line's rate on the new interface.
		state_set shaper_peak ""
		# Same reasoning for the uplink: a rate learned on the old WAN would
		# carve the new one wrong, and it only ever climbs by 3% per window.
		state_set uplink_learned ""
		: > "$PRIO_STATE/up_rate"
		: > "$PRIO_STATE/uptx"
		# The measurement baselines describe the old line; keeping them would
		# compare the new WAN against the old one for a day.
		state_set measured_dl ""
		state_set measured_ul ""
		state_set measured_at ""
		state_set measured_at_up ""
		: > "$PRIO_STATE/measure_err"
	fi

	# The uplink and downlink hooks must be on different interfaces.
	if [ "$dev" = "$lan" ]; then
		echo "wan_iface == lan_iface, refusing" >> "$PRIO_STATE/err"
		logger -t luci-app-prio "wan_iface and lan_iface are both $dev, refusing"
		release_lock
		return 1
	fi

	# 1. Acceleration: software flow offloading keeps packets on the qdisc path.
	if [ "$auto_fp" = 1 ]; then
		local cur saved
		cur="$(uci -q get turboacc.config.fastpath)"
		saved="$(state_get saved_fastpath)"
		if [ -z "$cur" ]; then
			# turboacc absent: nothing to switch, and never create its config
			echo "hnat:no-turboacc" >> "$PRIO_STATE/status"
		elif [ "$cur" != "flow_offloading" ] && [ "$cur" != "disabled" ]; then
			state_set saved_fastpath "$cur"
			uci -q set turboacc.config.fastpath='flow_offloading' && uci -q commit turboacc
			/etc/init.d/c2000max-hnat reload >/dev/null 2>&1
			wait_hnat_down || true
			# The controller writes "unknown" while converging and only then
			# the final state. It can bail out early (a reload_firewall race,
			# a bind table that is not empty yet), leaving the marker behind --
			# which is exactly what the page shows to the user. Retry once.
			local eff
			eff="$(cat "$EFFECTIVE_STATE" 2>/dev/null)"
			if [ "$eff" != "flow_offloading" ]; then
				logger -t luci-app-prio "accel state after switch: '${eff}', retrying"
				sleep 2
				/etc/init.d/c2000max-hnat reload >/dev/null 2>&1
				wait_hnat_down || true
				eff="$(cat "$EFFECTIVE_STATE" 2>/dev/null)"
				logger -t luci-app-prio "accel state after retry: '${eff}'"
			fi
			logger -t luci-app-prio "fastpath $cur -> flow_offloading"
		fi
		# verify the hardware hook really went down
		if [ -r "$HNAT_TOGGLE" ]; then
			[ "$(cat "$HNAT_TOGGLE" 2>/dev/null)" = "disabled" ] &&
				echo "hnat:off" >> "$PRIO_STATE/status" ||
				echo "hnat:still-enabled" >> "$PRIO_STATE/status"
		else
			echo "hnat:unknown" >> "$PRIO_STATE/status"
		fi
	fi

	# 2. netfilter marking
	setup_nft "$bands" "$dev" "$lan"

	# 3. uplink
	if [ "$uplink" = 1 ]; then
		setup_uplink "$dev" "$bands"
	else
		# nothing shapes the upload any more, so the page must not keep showing
		# the last rate it had
		: > "$PRIO_STATE/upshaper" 2>/dev/null
		qdisc_is_ours "$dev" && tc qdisc del dev "$dev" root 2>/dev/null
	fi

	# Capacity comes from a measurement, not from a guess: seed the estimate
	# from the last one, and if it is missing or stale run a fresh one in the
	# background (it takes about ten seconds and does not block the start).
	if [ "$auto_bw" = 1 ]; then
		local md mi at now stale
		md="$(state_get measured_dl)"
		case "$md" in ''|*[!0-9]*) md=0 ;; esac
		mi="$(state_get measure_interval)"
		case "$mi" in ''|*[!0-9]*) mi=0 ;; esac
		# 0 = no periodic measurement: a capacity probe costs real traffic
		# (over 100 MB on a fast line), which is not something to spend on a
		# mobile plan every hour. 0 still measures on start, when the latency
		# loop has cut the rate well below the last measurement, and when the
		# button is pressed.
		[ "$mi" -gt 0 ] && [ "$mi" -lt 120 ] && mi=120
		at="$(state_get measured_at)"
		case "$at" in ''|*[!0-9]*) at=0 ;; esac
		now=$(date +%s)
		stale=$(( now - at ))
		# Only a recent measurement may seed the shaper. The loop's cuts live in
		# tmpfs and never reach UCI, so seeding an old value on every boot would
		# undo them -- capacity had dropped to 30 Mbit while measured_dl still
		# said 185, and every restart went back to 166 Mbit for five windows.
		if [ "$md" -ge 1000 ] && [ "$stale" -lt 86400 ] && [ ! -s "$PRIO_STATE/shaper" ]; then
			printf '%s\n' "$md" > "$PRIO_STATE/shaper"
			printf '%s\n' "$md" > "$PRIO_STATE/peak"
		fi
		if [ "$md" -lt 1000 ] || { [ "$mi" -ge 120 ] && [ "$stale" -ge "$mi" ]; }; then
			( sleep 15; /etc/init.d/prio measure ) </dev/null >/dev/null 2>&1 &
			logger -t luci-app-prio "measurement scheduled (age ${stale}s)"
		fi
	fi

	# 4. downlink
	if [ "$downlink" = 1 ]; then
		setup_downlink "$lan" "$bands"
		[ "$auto_bw" = 1 ] && start_detect "$dev" "$lan" "$bands"
		start_refresh "$lan"
	elif qdisc_is_ours "$lan"; then
		tc qdisc del dev "$lan" root 2>/dev/null
	fi

	# Everything above reports failures by writing into $PRIO_STATE/status and
	# returning non-zero, and those returns used to be ignored: start printed
	# "started" and returned 0 even when the qdisc was never installed, so the
	# boot retry below could not notice. Check the result instead of assuming it.
	local ok=1
	[ "$downlink" = 1 ] && { qdisc_is_ours "$lan" || ok=0; }
	if [ "$downlink" = 1 ] && grep -q 'downlink:fail' "$PRIO_STATE/status" 2>/dev/null; then
		ok=0
	fi
	if [ "$uplink" = 1 ] && grep -q 'uplink:fail' "$PRIO_STATE/status" 2>/dev/null; then
		ok=0
	fi
	if [ "$ok" = 0 ]; then
		logger -t luci-app-prio "start failed: the queue was not installed (wan=$dev lan=$lan)"
		diag "start failed wan=${dev} lan=${lan} status=$(tr '\n' ',' < "$PRIO_STATE/status" 2>/dev/null)"
		release_lock
		return 1
	fi

	printf '%s\n' "$dev" > "$PRIO_STATE/dev"
	printf '%s\n' "$lan" > "$PRIO_STATE/lan"
	echo "started" >> "$PRIO_STATE/status"
	logger -t luci-app-prio "priority engine started (bands=$bands wan=$dev lan=$lan)"
	diag_maybe_prune
	diag "engine started bands=${bands} wan=${dev} lan=${lan} fq_codel=$(state_get fq_codel) margin=$(margin_pct) default_band=$(state_get default_band) up_kbit=$(state_get uplink_kbit)"
	release_lock
}

stop() {
	config_load prio
	local dev lan saved
	dev="$(cat "$PRIO_STATE/dev" 2>/dev/null)"
	lan="$(cat "$PRIO_STATE/lan" 2>/dev/null)"
	[ -n "$dev" ] || config_get dev main wan_iface eth2
	[ -n "$lan" ] || config_get lan main lan_iface br-lan

	stop_detect
	stop_refresh
	# A measurement killed outright leaves its marker behind; while it exists the
	# page says "measurement running" and the detector skips every window.
	rm -f "$PRIO_STATE/measuring"
	nft delete table $NFT_TABLE 2>/dev/null
	nft delete table inet prio 2>/dev/null

	qdisc_is_ours "$dev" && tc qdisc del dev "$dev" root 2>/dev/null
	qdisc_is_ours "$lan" && tc qdisc del dev "$lan" root 2>/dev/null

	# Restore acceleration only if we changed it; clear the marker regardless.
	saved="$(state_get saved_fastpath)"
	if [ -n "$saved" ]; then
		uci -q set turboacc.config.fastpath="$saved"
		uci -q commit turboacc
		/etc/init.d/c2000max-hnat reload >/dev/null 2>&1
		logger -t luci-app-prio "fastpath restored: $saved"
		uci -q set prio.main.saved_fastpath=''
		uci -q commit prio
	fi

	: > "$PRIO_STATE/upshaper" 2>/dev/null
	# Keep $PRIO_STATE/shaper: reload() must not throw away the learned rate.
	# Same for the uplink: a clean shutdown should not cost the last rate the
	# loop found, otherwise every reboot restarts the upload at "open".
	local uf upm upc
	uf="$(cat "$PRIO_STATE/up_rate" 2>/dev/null)"
	case "$uf" in ''|*[!0-9]*) uf=0 ;; esac
	upm="$(state_get uplink_kbit)"
	case "$upm" in ''|*[!0-9]*) upm=0 ;; esac
	# up_cfg records which uplink_kbit the live value belongs to. Without this
	# check a rate that was PINNED by hand would be folded into the automatic
	# memory the moment the user switched back to 0 without a reload.
	upc="$(cat "$PRIO_STATE/up_cfg" 2>/dev/null)"
	case "$upc" in ''|*[!0-9]*) upc=0 ;; esac
	if [ "$upm" -lt 1000 ] && [ "$upc" -lt 1000 ] && [ "$uf" -ge 2000 ]; then
		acquire_lock
		state_set uplink_learned "$uf"
		release_lock
	fi
	: > "$PRIO_STATE/status" 2>/dev/null
	logger -t luci-app-prio "priority engine stopped"
	diag_maybe_prune
	diag "engine stopped"
}

reload() {
	config_load prio
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		stop
		return 0
	fi

	local dev lan
	dev="$(cat "$PRIO_STATE/dev" 2>/dev/null)"
	lan="$(cat "$PRIO_STATE/lan" 2>/dev/null)"
	[ -n "$dev" ] || config_get dev main wan_iface eth2
	[ -n "$lan" ] || config_get lan main lan_iface br-lan
	stop_detect
	stop_refresh
	# Do NOT delete the nft table or the qdiscs here. start() rebuilds both
	# from scratch, but it can still bail out (disabled, wan == lan). Tearing
	# down first and bailing out left the router with no queue at all while
	# UCI said the feature was on.
	if [ "$enabled" != 1 ]; then
		stop
		return 0
	fi
	acquire_lock || return 1
	start
	release_lock
}

# Called by the LuCI save hook with the state the user just submitted. The
# hook can run while the commit is still landing, and reading the old value
# made the engine follow the *previous* switch position (stop when turning it
# on, and vice versa). Waiting for the file to agree removes that window
# entirely instead of racing it.
apply() {
	local want="$1"
	local i=0 cur
	while [ "$i" -lt 10 ]; do
		config_load prio
		config_get_bool cur main enabled 0
		[ "$cur" = "$want" ] && break
		sleep 1
		i=$((i + 1))
	done
	reload
}

status() {
	if [ -f "$PRIO_STATE/status" ] && grep -q started "$PRIO_STATE/status" 2>/dev/null; then
		echo running
		cat "$PRIO_STATE/status"
	else
		echo stopped
	fi
}

# rc.common calls boot() instead of start() at system boot. Overriding it lets
# us repair a stale saved_fastpath when the service is disabled: without this,
# an interrupted run leaves turboacc pinned to flow_offloading forever.
boot() {
	config_load prio
	# The log ages out even while the plugin is switched off; boot is the one
	# point guaranteed to run in that state.
	diag_maybe_prune
	if [ "$(state_get enabled)" != "1" ]; then
		local saved
		saved="$(state_get saved_fastpath)"
		if [ -n "$saved" ]; then
			uci -q set turboacc.config.fastpath="$saved"
			uci -q commit turboacc
			uci -q set prio.main.saved_fastpath=''
			uci -q commit prio
			/etc/init.d/c2000max-hnat reload >/dev/null 2>&1
			logger -t luci-app-prio "boot: restored stale fastpath $saved"
		fi
		return 0
	fi

	# The cellular interface takes tens of seconds to appear after a reboot. Starting
	# before it exists left the router UNSHAPED -- no queue, no priority -- until
	# someone noticed, which is exactly what happened twice on 2026-11-18. Wait
	# for the device and retry the start instead.
	# Detached: rcS runs boot() synchronously, and the modem can take minutes
	# to appear. Waiting here would hold up the rest of the boot for nothing.
	local dev
	config_get dev main wan_iface eth2
	(
		i=0
		while [ "$i" -lt 30 ]; do
			[ -e "/sys/class/net/$dev" ] && start && {
				[ "$i" -gt 0 ] && logger -t luci-app-prio "boot: shaper up after ${i} retries"
				exit 0
			}
			i=$((i + 1))
			sleep 10
		done
		logger -t luci-app-prio "boot: the shaper is NOT active (gave up after 5 minutes)"
		diag "boot: start failed after retries"
	) </dev/null >/dev/null 2>&1 &
	return 0
}
