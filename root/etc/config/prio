
config main 'main'
	option enabled '0'
	option auto_hnat_off '1'
	# 1 = capacity comes from a real measurement (about 10 s on start, then
	# every measure_interval seconds) and the latency loop may only LOWER the
	# rate. 0 = use shaper_kbit / uplink_kbit exactly as configured.
	option auto_bandwidth '1'
	option bands '3'
	# Devices that are not in the list are still shaped: they get this band.
	# Empty means the lowest one.
	option default_band ''
	# 1 = let each device have a different priority for upload and download.
	option split_bands '0'
	option strict_bands '1'
	option fq_codel '1'
	option uplink '1'
	option downlink '1'
	option lan_shaping '0'
	option lan_rate_kbit '0'
	option wan_iface 'eth2'
	option lan_iface 'br-lan'
	option shaper_kbit '0'
	option shaper_learned ''
	option shaper_peak ''
	option shaper_margin '10'
	option rtt_target '223.5.5.5'
	option saved_fastpath ''

	# 0 = automatic: the upload stays open until the router has seen three
	# clean measuring windows of real upload traffic, then it starts shaping
	# at what the line delivered and the latency loop trims it. A number of
	# 1000 or more pins the rate instead and the loop leaves it alone.
	option uplink_kbit '0'
	# Capacity measurement. Empty URLs fall back to the built-in defaults
	# (a mainland mirror for download, Cloudflare for upload).
	option measure_url ''
	option measure_up_url ''
	option measure_secs '6'
	option measure_interval '0'
	option measured_dl ''
	option measured_ul ''
	option measured_at ''
	option uplink_learned ''
